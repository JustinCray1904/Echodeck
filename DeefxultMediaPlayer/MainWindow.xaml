<Window x:Class="DeefxultMediaPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="Deefxult Media Player"
        Width="1100" Height="680" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Icon="Assets/app.ico"
        AllowDrop="True"
        Loaded="Window_Loaded"
        Drop="Window_Drop">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Video area. VideoView is a native surface ("airspace"), so the vault UI lives in its own window. -->
        <Grid x:Name="VideoHost" Grid.Row="0" Background="Black">
            <vlc:VideoView x:Name="VideoView">
                <!-- Content of VideoView renders above the video surface -->
                <TextBlock x:Name="EmptyHint"
                           Text="Open a video (Ctrl+O) or drop a file here"
                           Foreground="{StaticResource MutedBrush}" FontSize="15"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsHitTestVisible="False"/>
            </vlc:VideoView>
        </Grid>

        <!-- Transport bar -->
        <Border x:Name="ControlBar" Grid.Row="1"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource SlateBrush}" BorderThickness="0,1,0,0"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="PlayPauseButton" Grid.Column="0" Style="{StaticResource IconButton}"
                        Content="&#xE768;" ToolTip="Play / Pause (Space)" Click="PlayPause_Click"/>
                <Button Grid.Column="1" Style="{StaticResource IconButton}"
                        Content="&#xE8E5;" ToolTip="Open video (Ctrl+O)" Click="Open_Click"/>

                <TextBlock x:Name="TimeText" Grid.Column="2" Text="0:00" Margin="8,0,0,0"
                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                           FontFamily="Consolas" FontSize="12"/>

                <Slider x:Name="SeekSlider" Grid.Column="3" Style="{StaticResource DarkSlider}"
                        Minimum="0" Maximum="1000" IsMoveToPointEnabled="True" Margin="12,0"
                        PreviewMouseDown="SeekSlider_PreviewMouseDown"
                        PreviewMouseUp="SeekSlider_PreviewMouseUp"
                        ValueChanged="SeekSlider_ValueChanged"/>

                <TextBlock x:Name="DurationText" Grid.Column="4" Text="0:00"
                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                           FontFamily="Consolas" FontSize="12"/>

                <TextBlock Grid.Column="5" Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="16,0,8,0"/>

                <Slider x:Name="VolumeSlider" Grid.Column="6" Style="{StaticResource DarkSlider}"
                        Minimum="0" Maximum="100" Value="80" IsMoveToPointEnabled="True"
                        ValueChanged="VolumeSlider_ValueChanged"/>

                <Button Grid.Column="7" Style="{StaticResource IconButton}" Margin="10,0,0,0"
                        Content="&#xE740;" ToolTip="Fullscreen (F11)" Click="Fullscreen_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
