<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>DeefxultMediaPlayer</RootNamespace>
    <AssemblyName>DeefxultMediaPlayer</AssemblyName>
    <Product>Deefxult Media Player</Product>
    <Version>1.1.0</Version>
    <!-- LibVLC ships separate x86/x64 natives; this app is x64 only. -->
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Optional: compile the global low-level keyboard hook (off by default so the binary contains no
       SetWindowsHookEx imports). Build with:  dotnet build -c Release -p:EnableGlobalKeyHook=true -->
  <PropertyGroup Condition="'$(EnableGlobalKeyHook)' == 'true'">
    <DefineConstants>$(DefineConstants);GLOBAL_KEY_HOOK</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp" Version="3.8.5" />
    <PackageReference Include="LibVLCSharp.WPF" Version="3.8.5" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.20" />
    <!-- DPAPI: protects the vault's master key with the current Windows account -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <!-- Fail loudly at build/publish time instead of crashing on a fresh machine. -->
  <Target Name="VerifyLibVlcBuild" AfterTargets="Build">
    <Warning Condition="!Exists('$(OutDir)libvlc\win-x64\libvlc.dll')"
             Text="libvlc\win-x64\libvlc.dll is missing from $(OutDir). Restore the VideoLAN.LibVLC.Windows package and rebuild, or the app will fail to start." />
  </Target>
  <Target Name="VerifyLibVlcPublish" AfterTargets="Publish">
    <Warning Condition="!Exists('$(PublishDir)libvlc\win-x64\libvlc.dll')"
             Text="libvlc\win-x64\libvlc.dll is missing from the publish folder ($(PublishDir)). Copy bin\...\libvlc next to the exe before shipping." />
  </Target>

</Project>
