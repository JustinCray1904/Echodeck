<Window x:Class="DeefxultMediaPlayer.PinSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose your PIN"
        Width="400" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Icon="Assets/app.ico">

    <StackPanel Margin="24">
        <TextBlock Text="Choose your PIN" FontSize="18" FontWeight="SemiBold"
                   Foreground="{StaticResource TextBrush}"/>
        <TextBlock TextWrapping="Wrap" Margin="0,8,0,18" FontSize="12"
                   Foreground="{StaticResource MutedBrush}"
                   Text="Pick a 4-digit PIN. Hold Ctrl and type it at any time to open the vault. You can change it later from the gear button inside the vault."/>

        <TextBlock Text="PIN" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
        <PasswordBox x:Name="PinBox" Style="{StaticResource DarkPassword}" MaxLength="4"
                     PreviewTextInput="Digits_PreviewTextInput"/>

        <TextBlock Text="Confirm PIN" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,4"/>
        <PasswordBox x:Name="ConfirmBox" Style="{StaticResource DarkPassword}" MaxLength="4"
                     PreviewTextInput="Digits_PreviewTextInput"/>

        <TextBlock x:Name="ErrorText" Margin="0,10,0,0" MinHeight="16" FontSize="11"
                   Foreground="#FFFF5C6C" TextWrapping="Wrap"/>

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Not now (use default)" Style="{StaticResource FlatButton}"
                    Click="Skip_Click" IsCancel="True"/>
            <Button Grid.Column="2" Content="Save PIN" Style="{StaticResource AccentButton}"
                    Click="Save_Click" IsDefault="True"/>
        </Grid>
    </StackPanel>
</Window>
