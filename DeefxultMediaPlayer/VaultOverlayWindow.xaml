<Window x:Class="DeefxultMediaPlayer.VaultOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vault"
        Width="304" Height="344"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize" WindowStartupLocation="Manual"
        PreviewKeyDown="Window_PreviewKeyDown">

    <!-- The window is fixed-size and fully transparent; only this shell is visible/hit-testable.
         It animates between a 46x26 pill and a 300x340 control deck. -->
    <Border x:Name="Shell"
            HorizontalAlignment="Left" VerticalAlignment="Top"
            Width="46" Height="26" CornerRadius="13" Opacity="0.4"
            Background="#F2101015" BorderBrush="{StaticResource SlateBrush}" BorderThickness="1"
            ClipToBounds="True"
            MouseEnter="Shell_MouseEnter" MouseLeave="Shell_MouseLeave">
        <Grid>
            <!-- Idle pill: tiny lock -->
            <TextBlock x:Name="PillIcon" Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                       Foreground="{StaticResource MutedBrush}"
                       Width="44" Height="24" TextAlignment="Center" Padding="0,5,0,0"
                       HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"/>

            <!-- Hover deck -->
            <Grid x:Name="Deck" Width="298" Height="338"
                  HorizontalAlignment="Left" VerticalAlignment="Top"
                  Opacity="0" IsHitTestVisible="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="16,14,16,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="VAULT" Margin="8,0,0,0" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="CountText" VerticalAlignment="Center"
                                   FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                        <Button x:Name="PinButton" Style="{StaticResource IconButton}"
                                Content="&#xE713;" FontSize="13" Padding="6" Margin="6,-6,-6,-6"
                                ToolTip="Change PIN" Click="Pin_Click"/>
                    </StackPanel>
                </Grid>

                <ListBox x:Name="VaultList" Grid.Row="1" Margin="12,0"
                         Style="{StaticResource DarkList}"
                         ItemContainerStyle="{StaticResource DarkItem}"
                         MouseDoubleClick="VaultList_MouseDoubleClick"
                         SelectionChanged="VaultList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="12"
                                           Foreground="{StaticResource TextBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding SizeText}" FontSize="10"
                                           Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="StatusText" Grid.Row="2" Margin="16,8,16,0" FontSize="11"
                           Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"
                           MinHeight="14"/>

                <Grid Grid.Row="3" Margin="12,8,12,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ImportButton" Grid.Column="0" Content="Import"
                            Style="{StaticResource FlatButton}" Click="Import_Click"/>
                    <Button x:Name="PlayButton" Grid.Column="2" Content="Play"
                            Style="{StaticResource AccentButton}" Click="Play_Click"/>
                    <Button x:Name="DeleteButton" Grid.Column="4" Content="Delete"
                            Style="{StaticResource DangerButton}" Click="Delete_Click"
                            ToolTip="Permanently delete the selected video"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
