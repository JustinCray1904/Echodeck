<Window x:Class="EchoDeck.AnonymousSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource EchoWindow}"
        Title="Anonymous Mode settings"
        Width="960" Height="660"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <Grid Margin="14,0,14,14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" CornerRadius="10" Padding="10">
            <StackPanel>
                <TextBlock Text="Anonymous" Foreground="{DynamicResource Fg3Brush}" FontSize="12" Margin="12,6,0,8"/>
                <RadioButton x:Name="NavLibrary" Style="{StaticResource NavItem}" Content="Library"
                             Tag="{StaticResource IcoLock}" GroupName="AnonNav" IsChecked="True" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavPasscode" Style="{StaticResource NavItem}" Content="Passcode"
                             Tag="{StaticResource IcoKeyboard}" GroupName="AnonNav" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavSecurity" Style="{StaticResource NavItem}" Content="Security"
                             Tag="{StaticResource IcoShield}" GroupName="AnonNav" Checked="Nav_Checked"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="2" Background="{DynamicResource CardBrush}" CornerRadius="10">
            <Grid>
                <!-- ============ Library ============ -->
                <Grid x:Name="PageLibrary" Margin="26,22,26,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <StackPanel>
                            <TextBlock Text="Library" Style="{StaticResource PageTitle}"/>
                            <TextBlock x:Name="LibSummary" Style="{StaticResource HintText}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button x:Name="ImportFilesButton" Content="Import files…" Style="{StaticResource FlatButton}"
                                    Margin="0,0,8,0" Click="ImportFiles_Click"/>
                            <Button x:Name="ImportFolderButton" Content="Import folder…" Style="{StaticResource AccentButton}"
                                    Click="ImportFolder_Click"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,18,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Delete the originals after importing"/>
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="Securely wipes the unencrypted source file once its encrypted copy is verified."/>
                        </StackPanel>
                        <CheckBox x:Name="DeleteOriginalsSwitch" Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                  Click="DeleteOriginals_Click"/>
                    </Grid>

                    <ListBox x:Name="LibList" Grid.Row="2" Style="{StaticResource DarkList}"
                             ItemContainerStyle="{StaticResource DarkItem}"
                             MouseDoubleClick="LibList_MouseDoubleClick"
                             SelectionChanged="LibList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Kind, Mode=OneWay}" FontSize="12"
                                               Foreground="{DynamicResource MutedBrush}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding SizeText, Mode=OneWay}" FontSize="12"
                                               Foreground="{DynamicResource MutedBrush}" TextAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="LibStatus" Grid.Row="3" Margin="0,12,0,0" MinHeight="18" FontSize="12"
                               Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="PlayButton" Content="Play" Style="{StaticResource AccentButton}" MinWidth="90"
                                Margin="0,0,8,0" Click="Play_Click"/>
                        <Button x:Name="DeleteButton" Content="Delete" Style="{StaticResource DangerButton}" MinWidth="90"
                                Click="Delete_Click"/>
                    </StackPanel>
                </Grid>

                <!-- ============ Passcode ============ -->
                <ScrollViewer x:Name="PagePasscode" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="26,22,26,20">
                    <StackPanel Width="440" HorizontalAlignment="Left">
                        <TextBlock Text="Passcode" Style="{StaticResource PageTitle}"/>
                        <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,18"
                                   Text="Hold Ctrl and type your passcode anywhere in EchoDeck to switch to Anonymous Mode. 4 to 8 digits."/>
                        <TextBlock Text="Current passcode" Style="{StaticResource HintText}" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="CurrentBox" Style="{StaticResource DarkPassword}" MaxLength="8"
                                     PreviewTextInput="Digits_PreviewTextInput"/>
                        <TextBlock Text="New passcode" Style="{StaticResource HintText}" Margin="0,14,0,4"/>
                        <PasswordBox x:Name="NewBox" Style="{StaticResource DarkPassword}" MaxLength="8"
                                     PreviewTextInput="Digits_PreviewTextInput"/>
                        <TextBlock Text="Confirm new passcode" Style="{StaticResource HintText}" Margin="0,14,0,4"/>
                        <PasswordBox x:Name="ConfirmBox" Style="{StaticResource DarkPassword}" MaxLength="8"
                                     PreviewTextInput="Digits_PreviewTextInput"/>
                        <TextBlock x:Name="PasscodeStatus" Margin="0,12,0,0" MinHeight="18" FontSize="12"
                                   Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                        <Button Content="Save passcode" Style="{StaticResource AccentButton}" HorizontalAlignment="Left"
                                Margin="0,10,0,0" Click="SavePasscode_Click"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ Security ============ -->
                <ScrollViewer x:Name="PageSecurity" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="26,22,26,20">
                    <StackPanel>
                        <TextBlock Text="Security" Style="{StaticResource PageTitle}"/>

                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowLabel}" Text="Leave Anonymous Mode when the window is minimized"/>
                                <TextBlock Style="{StaticResource HintText}" Text="Wipes the open library and returns to normal mode immediately."/>
                            </StackPanel>
                            <CheckBox x:Name="ExitMinimizeSwitch" Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                      Click="ExitMinimize_Click"/>
                        </Grid>

                        

                        <TextBlock Text="How your files are protected" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Style="{StaticResource HintText}" LineHeight="20"
                                   Text="Every imported file is encrypted with AES-256-GCM under its own key, stored under a random name in a hidden folder, with the original file name encrypted too. The master key is wrapped by your Windows account (DPAPI) and kept outside the vault folder, so copying the folder to another PC or account yields nothing readable."/>
                        <TextBlock Style="{StaticResource HintText}" LineHeight="20" Margin="0,10,0,0"
                                   Text="Playback is decrypted in memory only. Nothing played in Anonymous Mode is written to disk: no history, no resume positions, no snapshots. Deleting an item overwrites it with random data before removing it. Esc leaves Anonymous Mode instantly."/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
