<Window x:Class="EchoDeck.EqualizerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource EchoWindow}"
        Title="Equaliser"
        Width="600" Height="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="VSlider" TargetType="Slider">
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="Height" Value="170"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Border Width="6" CornerRadius="3" Background="{DynamicResource TrackBrush}" HorizontalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource InvisibleRepeat}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource InvisibleRepeat}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="20" Height="20">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="10" Background="{DynamicResource AccentBrush}"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="26,0,26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock Text="Equaliser" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="StateText" Text="Off" Foreground="{DynamicResource Fg1Brush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <CheckBox x:Name="EnableSwitch" Style="{StaticResource SwitchToggle}" Click="Enable_Click"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,0">
            <TextBlock Text="Preset" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <ComboBox x:Name="PresetCombo" Style="{StaticResource EchoCombo}" Width="220" Height="34" SelectionChanged="Preset_Changed"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,18,0,0" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Height="170" Margin="0,0,10,22" VerticalAlignment="Top">
                <TextBlock Text="+12 dB" FontSize="12" Foreground="{DynamicResource Fg1Brush}" VerticalAlignment="Top" TextAlignment="Right"/>
                <TextBlock Text="0 dB" FontSize="12" Foreground="{DynamicResource Fg1Brush}" VerticalAlignment="Center" TextAlignment="Right"/>
                <TextBlock Text="−12 dB" FontSize="12" Foreground="{DynamicResource Fg1Brush}" VerticalAlignment="Bottom" TextAlignment="Right"/>
            </Grid>
            <StackPanel x:Name="BandsPanel" Grid.Column="1" Orientation="Horizontal"/>
        </Grid>

        <Button Grid.Row="3" Content="Close" Style="{StaticResource FlatButton}" Padding="20,9" IsCancel="True" IsDefault="True"
                Click="Close_Click"/>
    </Grid>
</Window>
