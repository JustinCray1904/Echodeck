<Window x:Class="EchoDeck.WhisperSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource EchoWindow}"
        Title="Download Whisper"
        Width="660" Height="720" MinWidth="560" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <Grid Margin="24,0,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Choose a Whisper model" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Whisper runs on this PC and nothing about your music is uploaded. Bigger models write more accurate lyrics but take much longer, and a song can take several minutes even with a small one. The download is the only time Tempo goes online."/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ModelList" Margin="0,0,8,0"/>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0">
                <TextBlock Style="{StaticResource RowLabel}" Text="Also download the whisper.cpp program"/>
                <TextBlock x:Name="ProgramHint" Style="{StaticResource HintText}" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <CheckBox x:Name="ProgramSwitch" Grid.Column="1" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center"/>
        </Grid>

        <StackPanel Grid.Row="3" Margin="0,16,0,0">
            <TextBlock x:Name="StatusText" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/>
            <Border x:Name="ProgressTrack" Height="5" CornerRadius="3" Background="{DynamicResource TrackBrush}" Visibility="Collapsed" Margin="0,0,0,12">
                <Border x:Name="ProgressFill" Width="0" HorizontalAlignment="Left" CornerRadius="3" Background="{DynamicResource AccentBrush}"/>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CloseButton" Content="Close" Style="{StaticResource FlatButton}" Padding="20,9" Margin="0,0,8,0" IsCancel="True" Click="Close_Click"/>
                <Button x:Name="DownloadButton" Content="Download" Style="{StaticResource AccentButton}" Padding="24,9" Click="Download_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
