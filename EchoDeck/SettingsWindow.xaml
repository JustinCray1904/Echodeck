<Window x:Class="EchoDeck.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource EchoWindow}"
        Title="Settings"
        Width="1020" Height="740"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <Grid Margin="14,0,14,14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" CornerRadius="10" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,6">
                    <TextBox x:Name="SearchBox" Style="{StaticResource DarkTextBox}" Padding="34,8,10,8"
                             TextChanged="SearchBox_TextChanged"/>
                    <Path Style="{StaticResource Ico}" Data="{StaticResource IcoSearch}" Stroke="{DynamicResource Fg3Brush}"
                          HorizontalAlignment="Left" Margin="6,0,0,0"/>
                    <TextBlock x:Name="SearchHint" Text="Search" Margin="36,0,0,0" FontSize="13"
                               Foreground="{DynamicResource Fg3Brush}" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="SecApp" Text="App" Foreground="{DynamicResource Fg3Brush}" FontSize="12" Margin="12,4,0,6"/>
                        <RadioButton x:Name="NavGeneral" Style="{StaticResource NavItem}" Content="General" Tag="{StaticResource IcoSliders}" GroupName="SettingsNav" IsChecked="True" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavInterface" Style="{StaticResource NavItem}" Content="Interface" Tag="{StaticResource IcoCursor}" GroupName="SettingsNav" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavPrivacy" Style="{StaticResource NavItem}" Content="Privacy" Tag="{StaticResource IcoShield}" GroupName="SettingsNav" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavControls" Style="{StaticResource NavItem}" Content="Controls" Tag="{StaticResource IcoKeyboard}" GroupName="SettingsNav" Checked="Nav_Checked"/>
                        <TextBlock x:Name="SecMedia" Text="Media" Foreground="{DynamicResource Fg3Brush}" FontSize="12" Margin="12,12,0,6"/>
                        <RadioButton x:Name="NavPlayback" Style="{StaticResource NavItem}" Content="Playback" Tag="{StaticResource IcoPlay}" GroupName="SettingsNav" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavVideo" Style="{StaticResource NavItem}" Content="Video" Tag="{StaticResource IcoVideo}" GroupName="SettingsNav" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavAudio" Style="{StaticResource NavItem}" Content="Audio" Tag="{StaticResource IcoAudio}" GroupName="SettingsNav" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavSubtitles" Style="{StaticResource NavItem}" Content="Subtitles" Tag="{StaticResource IcoSubtitles}" GroupName="SettingsNav" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavLibrary" Style="{StaticResource NavItem}" Content="Library" Tag="{StaticResource IcoFolder}" GroupName="SettingsNav" Checked="Nav_Checked"/>
                        <TextBlock x:Name="SecSystem" Text="System" Foreground="{DynamicResource Fg3Brush}" FontSize="12" Margin="12,12,0,6"/>
                        <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}" Content="About" Tag="{StaticResource IcoInfo}" GroupName="SettingsNav" Checked="Nav_Checked"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border Grid.Column="2" Background="{DynamicResource CardBrush}" CornerRadius="10">
            <Grid>
                <ScrollViewer x:Name="PageGeneral" VerticalScrollBarVisibility="Auto" Padding="30,24,30,24">
                    <StackPanel>
                        <TextBlock Text="General" Style="{StaticResource PageTitle}"/>
                        
                        <Border Height="1" Background="{DynamicResource SlateBrush}" Margin="0,16,0,6" Opacity="0.5"/>
                        <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Style="{StaticResource RowLabel}" Text="Theme"/>
                                <TextBlock Style="{StaticResource HintText}" Margin="0,2,0,0" Text="Light, dark, or follow Windows."/>
                            </StackPanel>
                            <ComboBox x:Name="ThemeCombo" Grid.Column="1" Style="{StaticResource EchoCombo}" SelectionChanged="Combo_Changed"><ComboBoxItem Content="Dark"/><ComboBoxItem Content="Light"/><ComboBoxItem Content="System"/></ComboBox>
                        </Grid>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Style="{StaticResource RowLabel}" Text="Accent colour"/>
                                <TextBlock Style="{StaticResource HintText}" Margin="0,2,0,0" Text="Used for buttons, the seek bar and the volume bar."/>
                            </StackPanel>
                            <ComboBox x:Name="AccentCombo" Grid.Column="1" Style="{StaticResource EchoCombo}" SelectionChanged="Combo_Changed"><ComboBoxItem Content="Sky (light blue)"/><ComboBoxItem Content="Blue"/><ComboBoxItem Content="Teal"/><ComboBoxItem Content="Green"/><ComboBoxItem Content="Yellow"/><ComboBoxItem Content="Orange"/><ComboBoxItem Content="Red"/><ComboBoxItem Content="Purple"/><ComboBoxItem Content="Pink"/></ComboBox>
                        </Grid>
                        <TextBlock Text="Welcome tour" Style="{StaticResource SectionTitle}"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Style="{StaticResource RowLabel}" Text="Show the welcome tour again"/>
                                <TextBlock Style="{StaticResource HintText}" Margin="0,2,0,0" Text="It will appear the next time EchoDeck starts."/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Show next launch" Style="{StaticResource FlatButton}" Click="ShowTour_Click"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="PageInterface" VerticalScrollBarVisibility="Auto" Padding="30,24,30,24" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Interface" Style="{StaticResource PageTitle}"/>
                        
                        <Border Height="1" Background="{DynamicResource SlateBrush}" Margin="0,16,0,6" Opacity="0.5"/>
                        <TextBlock Text="Layout" Style="{StaticResource SectionTitle}"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Style="{StaticResource RowLabel}" Text="Show the side panel at start"/>
                                <TextBlock Style="{StaticResource HintText}" Margin="0,2,0,0" Text="The file browser and queue on the left."/>
                            </StackPanel>
                            <CheckBox x:Name="SidebarSwitch" Grid.Column="1" Style="{StaticResource SwitchToggle}" Click="Switch_Click"/>
                        </Grid>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Style="{StaticResource RowLabel}" Text="Show “Anonymous Mode” in the app menu"/>
                                <TextBlock Style="{StaticResource HintText}" Margin="0,2,0,0" Text="Turn off to keep the Ctrl + passcode gesture as the only way in."/>
                            </StackPanel>
                            <CheckBox x:Name="MenuSwitch" Grid.Column="1" Style="{StaticResource SwitchToggle}" Click="Switch_Click"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="PagePrivacy" VerticalScrollBarVisibility="Auto" Padding="30,24,30,24" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Privacy" Style="{StaticResource PageTitle}"/>
                        
                        <Border Height="1" Background="{DynamicResource SlateBrush}" Margin="0,16,0,6" Opacity="0.5"/>
                        <TextBlock Text="Anonymous Mode passcode" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,14"
                                   Text="Hold Ctrl and type your passcode (4 to 8 digits) to switch to Anonymous Mode. Imported files are encrypted and only play from there."/>
                        <StackPanel x:Name="PrivCurrentPanel" MaxWidth="420" HorizontalAlignment="Left">
                            <TextBlock Text="Current passcode" Style="{StaticResource HintText}" Margin="0,0,0,4"/>
                            <PasswordBox x:Name="PrivCurrentBox" Style="{StaticResource DarkPassword}" MaxLength="8" PreviewTextInput="Digits_PreviewTextInput"/>
                        </StackPanel>
                        <StackPanel MaxWidth="420" HorizontalAlignment="Left">
                            <TextBlock x:Name="PrivNewLabel" Text="New passcode" Style="{StaticResource HintText}" Margin="0,12,0,4"/>
                            <PasswordBox x:Name="PrivNewBox" Style="{StaticResource DarkPassword}" MaxLength="8" PreviewTextInput="Digits_PreviewTextInput"/>
                            <TextBlock Text="Confirm passcode" Style="{StaticResource HintText}" Margin="0,12,0,4"/>
                            <PasswordBox x:Name="PrivConfirmBox" Style="{StaticResource DarkPassword}" MaxLength="8" PreviewTextInput="Digits_PreviewTextInput"/>
                            <TextBlock x:Name="PrivStatus" Margin="0,12,0,0" MinHeight="18" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
                            <Button x:Name="PrivSaveButton" Content="Save passcode" Style="{StaticResource AccentButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Click="SavePasscode_Click"/>
                        </StackPanel>
                        <TextBlock Text="Behaviour" Style="{StaticResource SectionTitle}"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Style="{StaticResource RowLabel}" Text="Leave Anonymous Mode when the window is minimized"/>
                                <TextBlock Style="{StaticResource HintText}" Margin="0,2,0,0" Text="Wipes the open library and returns to normal mode immediately."/>
                            </StackPanel>
                            <CheckBox x:Name="MinimizeSwitch" Grid.Column="1" Style="{StaticResource SwitchToggle}" Click="Switch_Click"/>
                        </Grid>
                        <TextBlock Text="History" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Style="{StaticResource HintText}" Text="EchoDeck never records what you watch or listen to: no history, no resume positions. Only your preferences are saved."/>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="PageControls" VerticalScrollBarVisibility="Auto" Padding="30,24,30,24" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Controls" Style="{StaticResource PageTitle}"/>
                        <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0" Text="Keys work anywhere in the player while no dialog is open."/>
                        <Border Height="1" Background="{DynamicResource SlateBrush}" Margin="0,16,0,6" Opacity="0.5"/>
                        <TextBlock Text="Keyboard shortcuts" Style="{StaticResource SectionTitle}"/>
                                                <Grid Margin="0,0,0,9">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource RowLabel}" Text="Play / Pause"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal"><Border Style="{StaticResource KeyCap}"><TextBlock Text="Space" FontSize="12" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/></Border></StackPanel>
                                                </Grid>
                                                <Grid Margin="0,0,0,9">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource RowLabel}" Text="Seek backward / forward"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal"><Border Style="{StaticResource KeyCap}"><TextBlock Text="←" FontSize="12" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/></Border><TextBlock Text="/" Margin="6,0" FontSize="12" Foreground="{DynamicResource Fg3Brush}" VerticalAlignment="Center"/><Border Style="{StaticResource KeyCap}"><TextBlock Text="→" FontSize="12" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/></Border></StackPanel>
                                                </Grid>
                                                <Grid Margin="0,0,0,9">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource RowLabel}" Text="Volume up / down"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal"><Border Style="{StaticResource KeyCap}"><TextBlock Text="↑" FontSize="12" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/></Border><TextBlock Text="/" Margin="6,0" FontSize="12" Foreground="{DynamicResource Fg3Brush}" VerticalAlignment="Center"/><Border Style="{StaticResource KeyCap}"><TextBlock Text="↓" FontSize="12" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/></Border></StackPanel>
                                                </Grid>
                                                <Grid Margin="0,0,0,9">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource RowLabel}" Text="Mute"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal"><Border Style="{StaticResource KeyCap}"><TextBlock Text="M" FontSize="12" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/></Border></StackPanel>
                                                </Grid>
                                                <Grid Margin="0,0,0,9">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource RowLabel}" Text="Previous / Next item"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal"><Border Style="{StaticResource KeyCap}"><TextBlock Text="Shift + ," FontSize="12" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/></Border><TextBlock Text="/" Margin="6,0" FontSize="12" Foreground="{DynamicResource Fg3Brush}" VerticalAlignment="Center"/><Border Style="{StaticResource KeyCap}"><TextBlock Text="Shift + ." FontSize="12" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/></Border></StackPanel>
                                                </Grid>
                                                <Grid Margin="0,0,0,9">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource RowLabel}" Text="Next frame (when paused)"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal"><Border Style="{StaticResource KeyCap}"><TextBlock Text="." FontSize="12" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/></Border></StackPanel>
                                                </Grid>
                                                <Grid Margin="0,0,0,9">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource RowLabel}" Text="Cycle subtitle track"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal"><Border Style="{StaticResource KeyCap}"><TextBlock Text="V" FontSize="12" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/></Border></StackPanel>
                                                </Grid>
                                                <Grid Margin="0,0,0,9">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource RowLabel}" Text="Cycle audio track"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal"><Border Style="{StaticResource KeyCap}"><TextBlock Text="B" FontSize="12" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/></Border></StackPanel>
                                                </Grid>
                                                <Grid Margin="0,0,0,9">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource RowLabel}" Text="Toggle fullscreen"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal"><Border Style="{StaticResource KeyCap}"><TextBlock Text="F" FontSize="12" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/></Border><TextBlock Text="/" Margin="6,0" FontSize="12" Foreground="{DynamicResource Fg3Brush}" VerticalAlignment="Center"/><Border Style="{StaticResource KeyCap}"><TextBlock Text="F11" FontSize="12" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/></Border></StackPanel>
                                                </Grid>
                                                <Grid Margin="0,0,0,9">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource RowLabel}" Text="Show / hide queue"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal"><Border Style="{StaticResource KeyCap}"><TextBlock Text="Q" FontSize="12" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/></Border></StackPanel>
                                                </Grid>
                                                <Grid Margin="0,0,0,9">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource RowLabel}" Text="Show / hide file browser"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal"><Border Style="{StaticResource KeyCap}"><TextBlock Text="L" FontSize="12" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/></Border></StackPanel>
                                                </Grid>
                                                <Grid Margin="0,0,0,9">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource RowLabel}" Text="Take a snapshot"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal"><Border Style="{StaticResource KeyCap}"><TextBlock Text="Shift + S" FontSize="12" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/></Border></StackPanel>
                                                </Grid>
                                                <Grid Margin="0,0,0,9">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource RowLabel}" Text="Open a file"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal"><Border Style="{StaticResource KeyCap}"><TextBlock Text="Ctrl + O" FontSize="12" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/></Border></StackPanel>
                                                </Grid>
                                                <Grid Margin="0,0,0,9">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource RowLabel}" Text="Open settings"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal"><Border Style="{StaticResource KeyCap}"><TextBlock Text="Ctrl + ," FontSize="12" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/></Border></StackPanel>
                                                </Grid>
                                                <Grid Margin="0,0,0,9">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource RowLabel}" Text="Enter Anonymous Mode"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal"><Border Style="{StaticResource KeyCap}"><TextBlock Text="Ctrl + passcode" FontSize="12" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/></Border></StackPanel>
                                                </Grid>
                                                <Grid Margin="0,0,0,9">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource RowLabel}" Text="Leave Anonymous Mode / fullscreen"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal"><Border Style="{StaticResource KeyCap}"><TextBlock Text="Esc" FontSize="12" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/></Border></StackPanel>
                                                </Grid>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="PagePlayback" VerticalScrollBarVisibility="Auto" Padding="30,24,30,24" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Playback" Style="{StaticResource PageTitle}"/>
                        
                        <Border Height="1" Background="{DynamicResource SlateBrush}" Margin="0,16,0,6" Opacity="0.5"/>
                        <TextBlock Text="Queue" Style="{StaticResource SectionTitle}"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Style="{StaticResource RowLabel}" Text="Play the next item automatically"/>
                                <TextBlock Style="{StaticResource HintText}" Margin="0,2,0,0" Text="When a file ends, continue with the next one in the queue."/>
                            </StackPanel>
                            <CheckBox x:Name="AutoAdvanceSwitch" Grid.Column="1" Style="{StaticResource SwitchToggle}" Click="Switch_Click"/>
                        </Grid>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Style="{StaticResource RowLabel}" Text="Repeat"/>
                                <TextBlock Style="{StaticResource HintText}" Margin="0,2,0,0" Text="What happens when the queue ends."/>
                            </StackPanel>
                            <ComboBox x:Name="LoopCombo" Grid.Column="1" Style="{StaticResource EchoCombo}" SelectionChanged="Combo_Changed"><ComboBoxItem Content="Off"/><ComboBoxItem Content="Repeat one"/><ComboBoxItem Content="Repeat all"/></ComboBox>
                        </Grid>
                        <TextBlock Text="Speed and seeking" Style="{StaticResource SectionTitle}"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Style="{StaticResource RowLabel}" Text="Default speed"/>
                                <TextBlock Style="{StaticResource HintText}" Margin="0,2,0,0" Text="Applied whenever a new file starts."/>
                            </StackPanel>
                            <ComboBox x:Name="SpeedCombo" Grid.Column="1" Style="{StaticResource EchoCombo}" SelectionChanged="Combo_Changed"><ComboBoxItem Content="0.5x"/><ComboBoxItem Content="0.75x"/><ComboBoxItem Content="1x (normal)"/><ComboBoxItem Content="1.25x"/><ComboBoxItem Content="1.5x"/><ComboBoxItem Content="2x"/></ComboBox>
                        </Grid>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Style="{StaticResource RowLabel}" Text="Skip interval"/>
                                <TextBlock Style="{StaticResource HintText}" Margin="0,2,0,0" Text="Used by the back / forward buttons and the arrow keys."/>
                            </StackPanel>
                            <ComboBox x:Name="SkipCombo" Grid.Column="1" Style="{StaticResource EchoCombo}" SelectionChanged="Combo_Changed"><ComboBoxItem Content="5 seconds"/><ComboBoxItem Content="10 seconds"/><ComboBoxItem Content="15 seconds"/><ComboBoxItem Content="30 seconds"/></ComboBox>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="PageVideo" VerticalScrollBarVisibility="Auto" Padding="30,24,30,24" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Video" Style="{StaticResource PageTitle}"/>
                        
                        <Border Height="1" Background="{DynamicResource SlateBrush}" Margin="0,16,0,6" Opacity="0.5"/>
                        <TextBlock Text="Output" Style="{StaticResource SectionTitle}"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Style="{StaticResource RowLabel}" Text="Start videos in fullscreen"/>
                                <TextBlock Style="{StaticResource HintText}" Margin="0,2,0,0" Text="Esc or F brings the controls back."/>
                            </StackPanel>
                            <CheckBox x:Name="FullscreenSwitch" Grid.Column="1" Style="{StaticResource SwitchToggle}" Click="Switch_Click"/>
                        </Grid>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Style="{StaticResource RowLabel}" Text="Keep the screen awake during playback"/>
                                <TextBlock Style="{StaticResource HintText}" Margin="0,2,0,0" Text="Stops the screensaver and sleep while a video plays."/>
                            </StackPanel>
                            <CheckBox x:Name="AwakeSwitch" Grid.Column="1" Style="{StaticResource SwitchToggle}" Click="Switch_Click"/>
                        </Grid>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Style="{StaticResource RowLabel}" Text="Hardware decoding"/>
                                <TextBlock Style="{StaticResource HintText}" Margin="0,2,0,0" Text="Uses your GPU where possible. Applies the next time EchoDeck starts."/>
                            </StackPanel>
                            <CheckBox x:Name="HwSwitch" Grid.Column="1" Style="{StaticResource SwitchToggle}" Click="Switch_Click"/>
                        </Grid>
                        <TextBlock Text="Picture" Style="{StaticResource SectionTitle}"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Hue"/>
                            <Slider x:Name="HueSlider" Grid.Column="1" Style="{StaticResource FigmaSlider}" Minimum="-180" Maximum="180" IsMoveToPointEnabled="True" ValueChanged="Slider_Changed"/>
                            <TextBlock x:Name="HueSliderValue" Grid.Column="2" Style="{StaticResource HintText}" TextAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Brightness"/>
                            <Slider x:Name="BrightnessSlider" Grid.Column="1" Style="{StaticResource FigmaSlider}" Minimum="0" Maximum="2" IsMoveToPointEnabled="True" ValueChanged="Slider_Changed"/>
                            <TextBlock x:Name="BrightnessSliderValue" Grid.Column="2" Style="{StaticResource HintText}" TextAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Contrast"/>
                            <Slider x:Name="ContrastSlider" Grid.Column="1" Style="{StaticResource FigmaSlider}" Minimum="0" Maximum="2" IsMoveToPointEnabled="True" ValueChanged="Slider_Changed"/>
                            <TextBlock x:Name="ContrastSliderValue" Grid.Column="2" Style="{StaticResource HintText}" TextAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Saturation"/>
                            <Slider x:Name="SaturationSlider" Grid.Column="1" Style="{StaticResource FigmaSlider}" Minimum="0" Maximum="3" IsMoveToPointEnabled="True" ValueChanged="Slider_Changed"/>
                            <TextBlock x:Name="SaturationSliderValue" Grid.Column="2" Style="{StaticResource HintText}" TextAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Gamma"/>
                            <Slider x:Name="GammaSlider" Grid.Column="1" Style="{StaticResource FigmaSlider}" Minimum="0.1" Maximum="4" IsMoveToPointEnabled="True" ValueChanged="Slider_Changed"/>
                            <TextBlock x:Name="GammaSliderValue" Grid.Column="2" Style="{StaticResource HintText}" TextAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Margin="0,4,0,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Reset picture"/>
                            <Button Grid.Column="1" Content="Reset" Style="{StaticResource FlatButton}" Padding="22,7" Click="ResetPicture_Click"/>
                        </Grid>
                        <TextBlock Text="Framing" Style="{StaticResource SectionTitle}"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Style="{StaticResource RowLabel}" Text="Aspect ratio"/>
                                <TextBlock Style="{StaticResource HintText}" Margin="0,2,0,0" Text="Force a ratio when a file is stretched or letterboxed."/>
                            </StackPanel>
                            <ComboBox x:Name="AspectCombo" Grid.Column="1" Style="{StaticResource EchoCombo}" SelectionChanged="Combo_Changed"><ComboBoxItem Content="Default"/><ComboBoxItem Content="16:9"/><ComboBoxItem Content="4:3"/><ComboBoxItem Content="1:1"/><ComboBoxItem Content="21:9"/><ComboBoxItem Content="16:10"/></ComboBox>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="PageAudio" VerticalScrollBarVisibility="Auto" Padding="30,24,30,24" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Audio" Style="{StaticResource PageTitle}"/>
                        
                        <Border Height="1" Background="{DynamicResource SlateBrush}" Margin="0,16,0,6" Opacity="0.5"/>
                        <TextBlock Text="Volume" Style="{StaticResource SectionTitle}"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Volume"/>
                            <Slider x:Name="VolumeSlider" Grid.Column="1" Style="{StaticResource FigmaSlider}" Minimum="0" Maximum="100" IsMoveToPointEnabled="True" ValueChanged="Slider_Changed"/>
                            <TextBlock x:Name="VolumeSliderValue" Grid.Column="2" Style="{StaticResource HintText}" TextAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0" Text="Switch audio tracks from the audio button in the control bar (or press B). Music files open in the dedicated music view."/>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="PageSubtitles" VerticalScrollBarVisibility="Auto" Padding="30,24,30,24" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Subtitles" Style="{StaticResource PageTitle}"/>
                        
                        <Border Height="1" Background="{DynamicResource SlateBrush}" Margin="0,16,0,6" Opacity="0.5"/>
                        <TextBlock Text="Subtitles" Style="{StaticResource SectionTitle}"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Style="{StaticResource RowLabel}" Text="Show subtitles by default"/>
                                <TextBlock Style="{StaticResource HintText}" Margin="0,2,0,0" Text="Turn off to start every video without subtitles."/>
                            </StackPanel>
                            <CheckBox x:Name="SubsOnSwitch" Grid.Column="1" Style="{StaticResource SwitchToggle}" Click="Switch_Click"/>
                        </Grid>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Style="{StaticResource RowLabel}" Text="Text size"/>
                                <TextBlock Style="{StaticResource HintText}" Margin="0,2,0,0" Text="Applies the next time EchoDeck starts."/>
                            </StackPanel>
                            <ComboBox x:Name="SubSizeCombo" Grid.Column="1" Style="{StaticResource EchoCombo}" SelectionChanged="Combo_Changed"><ComboBoxItem Content="Small"/><ComboBoxItem Content="Normal"/><ComboBoxItem Content="Large"/><ComboBoxItem Content="Larger"/></ComboBox>
                        </Grid>
                        <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0" Text="Add a subtitle file for the current video from the subtitles button in the control bar."/>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="PageLibrary" VerticalScrollBarVisibility="Auto" Padding="30,24,30,24" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Library" Style="{StaticResource PageTitle}"/>
                        
                        <Border Height="1" Background="{DynamicResource SlateBrush}" Margin="0,16,0,6" Opacity="0.5"/>
                        <TextBlock Text="Media folder" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,10" Text="The folder the side panel opens to."/>
                        <Grid MaxWidth="560" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="FolderBox" Style="{StaticResource DarkTextBox}" Padding="12,9" IsReadOnly="True"/>
                            <Button Grid.Column="2" Content="Browse" Style="{StaticResource FlatButton}" Padding="20,9" Click="BrowseFolder_Click"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="PageAbout" VerticalScrollBarVisibility="Auto" Padding="30,24,30,24" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="About" Style="{StaticResource PageTitle}"/>
                        
                        <Border Height="1" Background="{DynamicResource SlateBrush}" Margin="0,16,0,6" Opacity="0.5"/>
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Image Source="Assets/app.ico" Width="64" Height="64" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="EchoDeck" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock x:Name="VersionText" Style="{StaticResource HintText}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Style="{StaticResource HintText}" Margin="0,22,0,0" LineHeight="20" MaxWidth="560" HorizontalAlignment="Left"
                                   Text="A modern media player for video and music, built on the LibVLC engine, with an encrypted private space called Anonymous Mode. The interface follows the community VLC redesign."/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
