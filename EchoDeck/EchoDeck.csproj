<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>EchoDeck</RootNamespace>
    <AssemblyName>EchoDeck</AssemblyName>
    <Product>EchoDeck</Product>
    <Version>2.1.0</Version>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- LibVLC ships separate x86 / x64 natives; this app is x64 only, and pinning the runtime identifier here makes
         restore pull the matching runtime pack and keeps the libvlc\win-x64 folder in the output. -->
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>

    <!-- Start-up speed: loose files (no per-launch decompress / extract) + precompiled (ReadyToRun) code. The installer
         still compresses everything with LZMA, so the download stays small. -->
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <TieredPGO>false</TieredPGO>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Optional: compile the global low-level keyboard hook (off by default so the binary contains no
       SetWindowsHookEx imports). Build with:  dotnet build -c Release -p:EnableGlobalKeyHook=true -->
  <PropertyGroup Condition="'$(EnableGlobalKeyHook)' == 'true'">
    <DefineConstants>$(DefineConstants);GLOBAL_KEY_HOOK</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp" Version="3.8.5" />
    <!-- Decodes a few hundred short slices of an audio file to draw the waveform seek bar -->
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="LibVLCSharp.WPF" Version="3.8.5" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.20" />
    <!-- DPAPI: protects the vault's master key with the current Windows account -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <!-- Fail loudly at build/publish time instead of crashing on a fresh machine. -->
  <Target Name="VerifyLibVlcBuild" AfterTargets="Build">
    <Warning Condition="!Exists('$(OutDir)libvlc\win-x64\libvlc.dll')"
             Text="libvlc\win-x64\libvlc.dll is missing from $(OutDir). Restore the VideoLAN.LibVLC.Windows package and rebuild, or the app will fail to start." />
  </Target>

  <!-- Size: remove the parts of the LibVLC distribution this player never uses (Qt/skins GUI, Lua playlist scripts,
       stream-out/transcoding, service discovery, UI translations, SDK import libs, video encoders). Local playback,
       subtitles, snapshots and the encrypted vault stream (a custom media input) don't touch any of them.
       Opt out with:  dotnet publish -p:TrimLibVlc=false -->
  <Target Name="TrimLibVlc" AfterTargets="Publish" Condition="'$(TrimLibVlc)' != 'false'">
    <PropertyGroup>
      <VlcPub>$(PublishDir)libvlc\win-x64\</VlcPub>
    </PropertyGroup>
    <ItemGroup>
      <VlcTrimDir Include="$(VlcPub)lua" />
      <VlcTrimDir Include="$(VlcPub)locale" />
      <VlcTrimDir Include="$(VlcPub)hrtfs" />
      <VlcTrimDir Include="$(VlcPub)sdk" />
      <VlcTrimDir Include="$(VlcPub)plugins\gui" />
      <VlcTrimDir Include="$(VlcPub)plugins\lua" />
      <VlcTrimDir Include="$(VlcPub)plugins\stream_out" />
      <VlcTrimDir Include="$(VlcPub)plugins\services_discovery" />
      <VlcTrimDir Include="$(VlcPub)plugins\control" />
      <VlcTrimFile Include="$(VlcPub)*.lib" />
      <VlcTrimFile Include="$(VlcPub)*.def" />
      <VlcTrimFile Include="$(VlcPub)plugins\plugins.dat" />
      <VlcTrimFile Include="$(VlcPub)plugins\codec\libx264_plugin.dll" />
      <VlcTrimFile Include="$(VlcPub)plugins\codec\libx265_plugin.dll" />
      <VlcTrimFile Include="$(VlcPub)plugins\codec\libx262_plugin.dll" />
      <VlcTrimFile Include="$(VlcPub)plugins\codec\libschroedinger_plugin.dll" />
    </ItemGroup>
    <RemoveDir Directories="@(VlcTrimDir)" />
    <Delete Files="@(VlcTrimFile)" />
  </Target>

  <Target Name="VerifyLibVlcPublish" AfterTargets="TrimLibVlc">
    <Warning Condition="!Exists('$(PublishDir)libvlc\win-x64\libvlc.dll')"
             Text="libvlc\win-x64\libvlc.dll is missing from the publish folder ($(PublishDir)). Copy bin\...\libvlc next to the exe before shipping." />
  </Target>

</Project>
