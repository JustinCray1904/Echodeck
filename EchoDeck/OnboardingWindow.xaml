<Window x:Class="EchoDeck.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource EchoWindow}"
        Title=""
        Width="1000" Height="700"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <Window.Resources>
        <!-- Light / Dark / System cards -->
        <Style x:Key="ThemeCard" TargetType="RadioButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Margin="16,0">
                            <Border x:Name="Frame" Width="96" Height="96" CornerRadius="18" BorderThickness="3"
                                    BorderBrush="Transparent" Padding="4">
                                <Border CornerRadius="13" Background="{TemplateBinding Background}"/>
                            </Border>
                            <TextBlock Text="{TemplateBinding Content}" HorizontalAlignment="Center" Margin="0,10,0,0"
                                       FontSize="13" Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource SlateBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent colour dots -->
        <Style x:Key="Swatch" TargetType="RadioButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="7,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Width="46" Height="46" Background="Transparent">
                            <Ellipse x:Name="Ring" Stroke="Transparent" StrokeThickness="2"/>
                            <Ellipse Width="30" Height="30" Fill="{TemplateBinding Background}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource SlateBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="72"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <!-- ============ 1. Welcome ============ -->
            <StackPanel x:Name="Page0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="560">
                <Image Source="Assets/app.ico" Width="104" Height="104" HorizontalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="Welcome to EchoDeck!" FontSize="32" FontWeight="Light" HorizontalAlignment="Center"
                           Margin="0,26,0,0" Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Style="{StaticResource HintText}" FontSize="14" LineHeight="22" Margin="0,22,0,0"
                           Text="EchoDeck is a modern media player for video and music, with a private encrypted space called Anonymous Mode. Let's take a minute to set it up the way you like."/>
                <TextBlock Style="{StaticResource HintText}" Margin="0,34,0,8" Text="Choose a media folder to get started with"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FolderBox" Style="{StaticResource DarkTextBox}" Padding="12,9"/>
                    <Button Grid.Column="2" Content="Browse" Style="{StaticResource FlatButton}" Padding="20,9"
                            Click="Browse_Click"/>
                </Grid>
            </StackPanel>

            <!-- ============ 2. Theme + colour ============ -->
            <StackPanel x:Name="Page1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="Select your preferred theme and color." FontSize="22" FontWeight="Light"
                           HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,28,0,0">
                    <RadioButton x:Name="ThemeLight" Style="{StaticResource ThemeCard}" Content="Light" GroupName="Theme"
                                 Background="#FFC9CED6" Checked="Theme_Checked"/>
                    <RadioButton x:Name="ThemeDark" Style="{StaticResource ThemeCard}" Content="Dark" GroupName="Theme"
                                 Background="#FF2A2A2A" IsChecked="True" Checked="Theme_Checked"/>
                    <RadioButton x:Name="ThemeSystem" Style="{StaticResource ThemeCard}" Content="System" GroupName="Theme"
                                 Checked="Theme_Checked">
                        <RadioButton.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF2A2A2A" Offset="0.5"/>
                                <GradientStop Color="#FFC9CED6" Offset="0.5"/>
                            </LinearGradientBrush>
                        </RadioButton.Background>
                    </RadioButton>
                </StackPanel>

                <!-- live preview -->
                <Border Width="600" Height="230" CornerRadius="12" Margin="0,30,0,0" Background="{DynamicResource BgBrush}"
                        BorderBrush="{DynamicResource SlateBrush}" BorderThickness="1" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="46"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Ellipse Width="10" Height="10" Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Left" Margin="14,0,0,0"/>
                            <TextBlock Text="EchoDeck" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource RailBrush}"/>
                            <Border Grid.Column="1" Background="{DynamicResource PanelBrush}" Padding="12,10">
                                <StackPanel>
                                    <Border Height="8" CornerRadius="4" Background="{DynamicResource RaisedBrush}" Margin="0,0,40,8"/>
                                    <Border Height="8" CornerRadius="4" Background="{DynamicResource AccentDimBrush}" Margin="0,0,10,8"/>
                                    <Border Height="8" CornerRadius="4" Background="{DynamicResource RaisedBrush}" Margin="0,0,60,8"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="{DynamicResource BgBrush}">
                                <Image Source="Assets/app.ico" Width="54" Height="54" Opacity="0.85"/>
                            </Border>
                        </Grid>
                        <Grid Grid.Row="2" Margin="14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Bundle}" Padding="4">
                                <Border Width="40" Height="16" CornerRadius="4" Background="{DynamicResource AccentBrush}"/>
                            </Border>
                            <Border Grid.Column="1" Height="14" CornerRadius="5" Margin="16,0" Background="{DynamicResource TrackBrush}">
                                <Border Width="150" HorizontalAlignment="Left" CornerRadius="5" Background="{DynamicResource AccentMidBrush}"/>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Bundle}" Padding="8,6">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0">
                    <RadioButton x:Name="Accent0" Style="{StaticResource Swatch}" GroupName="Accent" Background="#5BB5FF" Tag="0" IsChecked="True" Checked="Accent_Checked"/>
                    <RadioButton x:Name="Accent1" Style="{StaticResource Swatch}" GroupName="Accent" Background="#4C7DFF" Tag="1" Checked="Accent_Checked"/>
                    <RadioButton x:Name="Accent2" Style="{StaticResource Swatch}" GroupName="Accent" Background="#2FC9C0" Tag="2" Checked="Accent_Checked"/>
                    <RadioButton x:Name="Accent3" Style="{StaticResource Swatch}" GroupName="Accent" Background="#46C26B" Tag="3" Checked="Accent_Checked"/>
                    <RadioButton x:Name="Accent4" Style="{StaticResource Swatch}" GroupName="Accent" Background="#E3B93B" Tag="4" Checked="Accent_Checked"/>
                    <RadioButton x:Name="Accent5" Style="{StaticResource Swatch}" GroupName="Accent" Background="#E08A2E" Tag="5" Checked="Accent_Checked"/>
                    <RadioButton x:Name="Accent6" Style="{StaticResource Swatch}" GroupName="Accent" Background="#EE5D5D" Tag="6" Checked="Accent_Checked"/>
                    <RadioButton x:Name="Accent7" Style="{StaticResource Swatch}" GroupName="Accent" Background="#9B7BFF" Tag="7" Checked="Accent_Checked"/>
                    <RadioButton x:Name="Accent8" Style="{StaticResource Swatch}" GroupName="Accent" Background="#E65DA2" Tag="8" Checked="Accent_Checked"/>
                </StackPanel>
            </StackPanel>

            <!-- ============ 3. Controls tour ============ -->
            <StackPanel x:Name="Page2" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="Everything you can control." FontSize="22" FontWeight="Light"
                           HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                <TextBlock Style="{StaticResource HintText}" HorizontalAlignment="Center" Margin="0,8,0,18"
                           Text="The control bar, left to right. Blue bundles hold the actions you use most."/>

                <!-- mock control bar -->
                <Border Width="880" Height="58" CornerRadius="10" Background="{DynamicResource CardBrush}" Margin="0,0,0,12">
                    <Grid Margin="16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Bundle}">
                            <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                                <Button Style="{StaticResource BundleButton}"><Path Style="{StaticResource IcoFilled}" Data="{StaticResource IcoPrevious}"/></Button>
                                <Button Style="{StaticResource BundleButton}"><Path Style="{StaticResource IcoFilled}" Data="{StaticResource IcoSeekBack}"/></Button>
                                <Button Style="{StaticResource PlayPillButton}" Margin="4,0"><Path Style="{StaticResource IcoFilled}" Data="{StaticResource IcoPlay}"/></Button>
                                <Button Style="{StaticResource BundleButton}"><Path Style="{StaticResource IcoFilled}" Data="{StaticResource IcoSeekFwd}"/></Button>
                                <Button Style="{StaticResource BundleButton}"><Path Style="{StaticResource IcoFilled}" Data="{StaticResource IcoNext}"/></Button>
                            </StackPanel>
                        </Border>
                        <Grid Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="00:02:10" FontSize="13" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Height="22" CornerRadius="6" Margin="12,0" Background="{DynamicResource TrackBrush}">
                                <Grid Margin="2">
                                    <Border Width="170" HorizontalAlignment="Left" CornerRadius="4" Background="{DynamicResource AccentMidBrush}"/>
                                    <Border Width="8" Margin="166,0,0,0" HorizontalAlignment="Left" CornerRadius="4" Background="{DynamicResource AccentBrush}"/>
                                </Grid>
                            </Border>
                            <TextBlock Grid.Column="2" Text="00:25:40" FontSize="13" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                            <ContentControl Foreground="{DynamicResource MutedBrush}"><Path Style="{StaticResource Ico}" Data="{StaticResource IcoVolume}"/></ContentControl>
                            <Border Width="70" Height="14" CornerRadius="5" Margin="6,0,0,0" Background="{DynamicResource TrackBrush}">
                                <Border Width="40" HorizontalAlignment="Left" CornerRadius="5" Background="{DynamicResource AccentMidBrush}"/>
                            </Border>
                        </StackPanel>
                        <Border Grid.Column="3" Style="{StaticResource Bundle}">
                            <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                                <Button Style="{StaticResource BundleButton}"><Path Style="{StaticResource Ico}" Data="{StaticResource IcoAudio}"/></Button>
                                <Button Style="{StaticResource BundleButton}"><Path Style="{StaticResource Ico}" Data="{StaticResource IcoSubtitles}"/></Button>
                                <Button Style="{StaticResource BundleButton}"><Path Style="{StaticResource Ico}" Data="{StaticResource IcoSettings}"/></Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <UniformGrid Columns="3" Width="900">
                    <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="14,12" Margin="5">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top"><Path Style="{StaticResource IcoFilled}" Data="{StaticResource IcoPlay}"/></ContentControl>
                            <StackPanel Margin="10,0,0,0" Width="196">
                                <TextBlock Text="Play / Pause" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Style="{StaticResource HintText}" Margin="0,3,0,0" Text="Starts and pauses playback. Press Space from anywhere."/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="14,12" Margin="5">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top"><Path Style="{StaticResource IcoFilled}" Data="{StaticResource IcoNext}"/></ContentControl>
                            <StackPanel Margin="10,0,0,0" Width="196">
                                <TextBlock Text="Previous / Next" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Style="{StaticResource HintText}" Margin="0,3,0,0" Text="Steps through the files of your folder or queue."/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="14,12" Margin="5">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top"><Path Style="{StaticResource IcoFilled}" Data="{StaticResource IcoSeekFwd}"/></ContentControl>
                            <StackPanel Margin="10,0,0,0" Width="196">
                                <TextBlock Text="Skip back / forward" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Style="{StaticResource HintText}" Margin="0,3,0,0" Text="Jumps 10 seconds (you can change it in Settings)."/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="14,12" Margin="5">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top"><Path Style="{StaticResource Ico}" Data="{StaticResource IcoClock}"/></ContentControl>
                            <StackPanel Margin="10,0,0,0" Width="196">
                                <TextBlock Text="Seek bar" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Style="{StaticResource HintText}" Margin="0,3,0,0" Text="Click or drag to jump anywhere. Elapsed and total time sit either side."/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="14,12" Margin="5">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top"><Path Style="{StaticResource Ico}" Data="{StaticResource IcoVolume}"/></ContentControl>
                            <StackPanel Margin="10,0,0,0" Width="196">
                                <TextBlock Text="Volume" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Style="{StaticResource HintText}" Margin="0,3,0,0" Text="Drag the blue bar, or click the speaker (M) to mute."/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="14,12" Margin="5">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top"><Path Style="{StaticResource Ico}" Data="{StaticResource IcoAudio}"/></ContentControl>
                            <StackPanel Margin="10,0,0,0" Width="196">
                                <TextBlock Text="Audio track" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Style="{StaticResource HintText}" Margin="0,3,0,0" Text="Pick another audio track. Shortcut: B."/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="14,12" Margin="5">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top"><Path Style="{StaticResource Ico}" Data="{StaticResource IcoSubtitles}"/></ContentControl>
                            <StackPanel Margin="10,0,0,0" Width="196">
                                <TextBlock Text="Subtitles" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Style="{StaticResource HintText}" Margin="0,3,0,0" Text="Choose a track or add a subtitle file. Shortcut: V."/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="14,12" Margin="5">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top"><Path Style="{StaticResource Ico}" Data="{StaticResource IcoSettings}"/></ContentControl>
                            <StackPanel Margin="10,0,0,0" Width="196">
                                <TextBlock Text="Settings" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Style="{StaticResource HintText}" Margin="0,3,0,0" Text="Video, audio, subtitles, playback and more. Ctrl + ,"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="14,12" Margin="5">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top"><Path Style="{StaticResource Ico}" Data="{StaticResource IcoPlaylist}"/></ContentControl>
                            <StackPanel Margin="10,0,0,0" Width="196">
                                <TextBlock Text="Side panel" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Style="{StaticResource HintText}" Margin="0,3,0,0" Text="Browse folders, search, and manage the queue. Q and L."/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="14,12" Margin="5">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top"><Path Style="{StaticResource Ico}" Data="{StaticResource IcoFullscreen}"/></ContentControl>
                            <StackPanel Margin="10,0,0,0" Width="196">
                                <TextBlock Text="Fullscreen" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Style="{StaticResource HintText}" Margin="0,3,0,0" Text="F or F11. Esc brings the controls back."/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="14,12" Margin="5">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top"><Path Style="{StaticResource Ico}" Data="{StaticResource IcoMusic}"/></ContentControl>
                            <StackPanel Margin="10,0,0,0" Width="196">
                                <TextBlock Text="Music view" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Style="{StaticResource HintText}" Margin="0,3,0,0" Text="Audio files get their own view with echo ripples."/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="14,12" Margin="5">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top"><Path Style="{StaticResource Ico}" Data="{StaticResource IcoMore}"/></ContentControl>
                            <StackPanel Margin="10,0,0,0" Width="196">
                                <TextBlock Text="Menu" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Style="{StaticResource HintText}" Margin="0,3,0,0" Text="Open files and folders, Anonymous Mode, shortcuts."/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </StackPanel>

            <!-- ============ 4. Anonymous Mode ============ -->
            <Grid x:Name="Page3" HorizontalAlignment="Center" VerticalAlignment="Center" Width="820" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <ContentControl Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Left" Width="58" Height="58">
                        <Path Style="{StaticResource Ico}" Data="{StaticResource IcoMask}">
                            <Path.RenderTransform><ScaleTransform ScaleX="2.2" ScaleY="2.2"/></Path.RenderTransform>
                        </Path>
                    </ContentControl>
                    <TextBlock Text="Anonymous Mode" FontSize="28" FontWeight="Light" Margin="0,26,0,0"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Style="{StaticResource HintText}" FontSize="14" LineHeight="22" Margin="0,14,0,0"
                               Text="A private space inside EchoDeck. Files you import are encrypted with AES-256 and can only be played from here. Nothing you watch in it is remembered."/>
                    <TextBlock Style="{StaticResource HintText}" FontSize="14" LineHeight="22" Margin="0,12,0,0"
                               Text="Switch to it any time by holding Ctrl and typing your passcode, or from the menu. The screen goes dark, the interface changes colour, and Esc brings you straight back."/>
                </StackPanel>

                <Border Grid.Column="2" Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="24">
                    <StackPanel>
                        <TextBlock Text="Create your passcode" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,16" Text="4 to 8 digits. You can change it later in Settings."/>
                        <PasswordBox x:Name="PassBox" Style="{StaticResource DarkPassword}" MaxLength="8"
                                     PreviewTextInput="Digits_PreviewTextInput"/>
                        <TextBlock Text="Confirm passcode" Style="{StaticResource HintText}" Margin="0,14,0,4"/>
                        <PasswordBox x:Name="PassConfirmBox" Style="{StaticResource DarkPassword}" MaxLength="8"
                                     PreviewTextInput="Digits_PreviewTextInput"/>
                        
                        <TextBlock x:Name="PassError" Margin="0,12,0,0" MinHeight="16" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource DangerBrush}"/>
                        <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0"
                                   Text="Leave both fields empty to set it up later."/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============ 5. Shortcuts ============ -->
            <StackPanel x:Name="Page4" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="Learn the basic keyboard shortcuts." FontSize="22" FontWeight="Light"
                           HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                <TextBlock Style="{StaticResource HintText}" HorizontalAlignment="Center" Margin="0,8,0,26"
                           Text="Find the full list any time in the menu or in Settings > Controls."/>
                <Grid Width="840">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="56"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Play / Pause"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"><Border Style="{StaticResource KeyCap}"><TextBlock Text="Space" FontSize="12" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/></Border></StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Seek backward / forward"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"><Border Style="{StaticResource KeyCap}"><TextBlock Text="←" FontSize="12" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/></Border><TextBlock Text="/" Margin="6,0" FontSize="12" Foreground="{DynamicResource Fg3Brush}" VerticalAlignment="Center"/><Border Style="{StaticResource KeyCap}"><TextBlock Text="→" FontSize="12" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/></Border></StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Volume up / down"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"><Border Style="{StaticResource KeyCap}"><TextBlock Text="↑" FontSize="12" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/></Border><TextBlock Text="/" Margin="6,0" FontSize="12" Foreground="{DynamicResource Fg3Brush}" VerticalAlignment="Center"/><Border Style="{StaticResource KeyCap}"><TextBlock Text="↓" FontSize="12" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/></Border></StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Mute"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"><Border Style="{StaticResource KeyCap}"><TextBlock Text="M" FontSize="12" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/></Border></StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Previous / Next item"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"><Border Style="{StaticResource KeyCap}"><TextBlock Text="Shift + ," FontSize="12" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/></Border><TextBlock Text="/" Margin="6,0" FontSize="12" Foreground="{DynamicResource Fg3Brush}" VerticalAlignment="Center"/><Border Style="{StaticResource KeyCap}"><TextBlock Text="Shift + ." FontSize="12" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/></Border></StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Next frame (when paused)"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"><Border Style="{StaticResource KeyCap}"><TextBlock Text="." FontSize="12" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/></Border></StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Cycle subtitle track"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"><Border Style="{StaticResource KeyCap}"><TextBlock Text="V" FontSize="12" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/></Border></StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Cycle audio track"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"><Border Style="{StaticResource KeyCap}"><TextBlock Text="B" FontSize="12" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/></Border></StackPanel>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Toggle fullscreen"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"><Border Style="{StaticResource KeyCap}"><TextBlock Text="F" FontSize="12" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/></Border><TextBlock Text="/" Margin="6,0" FontSize="12" Foreground="{DynamicResource Fg3Brush}" VerticalAlignment="Center"/><Border Style="{StaticResource KeyCap}"><TextBlock Text="F11" FontSize="12" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/></Border></StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Show / hide queue"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"><Border Style="{StaticResource KeyCap}"><TextBlock Text="Q" FontSize="12" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/></Border></StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Show / hide playlists"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"><Border Style="{StaticResource KeyCap}"><TextBlock Text="P" FontSize="12" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/></Border></StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Take a snapshot"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"><Border Style="{StaticResource KeyCap}"><TextBlock Text="Shift + S" FontSize="12" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/></Border></StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Open a file"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"><Border Style="{StaticResource KeyCap}"><TextBlock Text="Ctrl + O" FontSize="12" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/></Border></StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Open settings"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"><Border Style="{StaticResource KeyCap}"><TextBlock Text="Ctrl + ," FontSize="12" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/></Border></StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Enter Anonymous Mode"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"><Border Style="{StaticResource KeyCap}"><TextBlock Text="Ctrl + passcode" FontSize="12" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/></Border></StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Leave Anonymous Mode / fullscreen"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"><Border Style="{StaticResource KeyCap}"><TextBlock Text="Esc" FontSize="12" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/></Border></StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- footer -->
        <Grid Grid.Row="1" Margin="40,0,40,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="Dot0" Width="8" Height="8" Margin="4,0" Fill="{DynamicResource AccentBrush}"/>
                <Ellipse x:Name="Dot1" Width="8" Height="8" Margin="4,0" Fill="{DynamicResource SlateBrush}"/>
                <Ellipse x:Name="Dot2" Width="8" Height="8" Margin="4,0" Fill="{DynamicResource SlateBrush}"/>
                <Ellipse x:Name="Dot3" Width="8" Height="8" Margin="4,0" Fill="{DynamicResource SlateBrush}"/>
                <Ellipse x:Name="Dot4" Width="8" Height="8" Margin="4,0" Fill="{DynamicResource SlateBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="BackButton" Content="Back" Style="{StaticResource FlatButton}" Padding="24,8" Margin="0,0,10,0"
                        Click="Back_Click"/>
                <Button x:Name="NextButton" Content="Next" Style="{StaticResource AccentButton}" Padding="28,8"
                        Click="Next_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
