<Window x:Class="EchoDeck.AudioModWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource EchoWindow}"
        Title="Audio Mod"
        Width="640" Height="780" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <Grid Margin="26,0,26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Audio Mod" Style="{StaticResource PageTitle}"/>
                <TextBlock x:Name="SongTitle" Style="{StaticResource HintText}" TextTrimming="CharacterEllipsis" MaxWidth="440" HorizontalAlignment="Left"/>
            </StackPanel>
            <Button x:Name="ResetButton" Content="Reset" Style="{StaticResource FlatButton}" Padding="14,6" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Reset_Click"/>
        </Grid>

        <WrapPanel x:Name="PresetPanel" Grid.Row="1" Margin="0,12,0,4"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,6,0,8">
            <StackPanel Margin="0,0,14,0">

                <Grid Margin="0,6,0,0">
                    <TextBlock Text="Play speed" Style="{StaticResource RowLabel}"/>
                    <TextBlock x:Name="SpeedValue" Style="{StaticResource RowLabel}" HorizontalAlignment="Right"/>
                </Grid>
                <Slider x:Name="SpeedSlider" Style="{StaticResource ModernSlider}" Minimum="50" Maximum="200" SmallChange="1" LargeChange="5" Margin="0,4,0,16" ValueChanged="Slider_Changed"/>

                <Grid Margin="0,0,0,14">
                    <TextBlock Text="Distort" Style="{StaticResource RowLabel}" VerticalAlignment="Center"/>
                    <CheckBox x:Name="DistortSwitch" Style="{StaticResource SwitchToggle}" HorizontalAlignment="Right" Click="Switch_Click"/>
                </Grid>

                <Grid Margin="0,0,0,4">
                    <TextBlock Text="Reverb" Style="{StaticResource RowLabel}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock x:Name="ReverbValue" Style="{StaticResource RowLabel}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <CheckBox x:Name="ReverbSwitch" Style="{StaticResource SwitchToggle}" Click="Switch_Click"/>
                    </StackPanel>
                </Grid>
                <Slider x:Name="ReverbSlider" Style="{StaticResource ModernSlider}" Minimum="0" Maximum="100" SmallChange="1" LargeChange="5" Margin="0,2,0,16" ValueChanged="Slider_Changed"/>

                <Grid Margin="0,0,0,4">
                    <TextBlock Text="Delay (echo)" Style="{StaticResource RowLabel}" VerticalAlignment="Center"/>
                    <CheckBox x:Name="DelaySwitch" Style="{StaticResource SwitchToggle}" HorizontalAlignment="Right" Click="Switch_Click"/>
                </Grid>
                <Grid Margin="0,2,0,0">
                    <TextBlock Text="Time" Style="{StaticResource HintText}"/>
                    <TextBlock x:Name="DelayTimeValue" Style="{StaticResource HintText}" HorizontalAlignment="Right"/>
                </Grid>
                <Slider x:Name="DelayTimeSlider" Style="{StaticResource ModernSlider}" Minimum="0" Maximum="10" SmallChange="1" LargeChange="1" Margin="0,0,0,4" ValueChanged="Slider_Changed"/>
                <Grid>
                    <TextBlock Text="Intensity" Style="{StaticResource HintText}"/>
                    <TextBlock x:Name="DelayIntensityValue" Style="{StaticResource HintText}" HorizontalAlignment="Right"/>
                </Grid>
                <Slider x:Name="DelayIntensitySlider" Style="{StaticResource ModernSlider}" Minimum="0" Maximum="10" SmallChange="1" LargeChange="1" Margin="0,0,0,16" ValueChanged="Slider_Changed"/>

                <Grid>
                    <TextBlock Text="Pitch" Style="{StaticResource RowLabel}"/>
                    <TextBlock x:Name="PitchValue" Style="{StaticResource RowLabel}" HorizontalAlignment="Right"/>
                </Grid>
                <Slider x:Name="PitchSlider" Style="{StaticResource ModernSlider}" Minimum="-12" Maximum="12" SmallChange="1" LargeChange="1" Margin="0,4,0,16" ValueChanged="Slider_Changed"/>

                <Grid>
                    <TextBlock Text="Low pass filter" Style="{StaticResource RowLabel}"/>
                    <TextBlock x:Name="LowPassValue" Style="{StaticResource RowLabel}" HorizontalAlignment="Right"/>
                </Grid>
                <Slider x:Name="LowPassSlider" Style="{StaticResource ModernSlider}" Minimum="0" Maximum="100" SmallChange="1" LargeChange="5" Margin="0,4,0,16" ValueChanged="Slider_Changed"/>

                <Grid>
                    <TextBlock Text="High pass filter" Style="{StaticResource RowLabel}"/>
                    <TextBlock x:Name="HighPassValue" Style="{StaticResource RowLabel}" HorizontalAlignment="Right"/>
                </Grid>
                <Slider x:Name="HighPassSlider" Style="{StaticResource ModernSlider}" Minimum="0" Maximum="100" SmallChange="1" LargeChange="5" Margin="0,4,0,8" ValueChanged="Slider_Changed"/>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3">
            <ProgressBar x:Name="RenderBar" Height="4" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,8" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource SlateBrush}" BorderThickness="0"/>
            <Grid>
                <TextBlock x:Name="StatusText" Style="{StaticResource HintText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ApplyButton" Content="Apply" Style="{StaticResource AccentButton}" Padding="22,8" Click="Apply_Click"/>
                    <Button x:Name="CloseButton" Content="Close" Style="{StaticResource FlatButton}" Padding="18,8" Margin="8,0,0,0" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
