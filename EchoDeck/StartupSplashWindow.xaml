<Window x:Class="EchoDeck.StartupSplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tempo"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" WindowStartupLocation="Manual"
        Background="#0B0B0B" Foreground="#D9D9D9"
        Icon="Assets/app.ico">

    <!-- Fixed colours on purpose: the splash appears before the theme is applied. -->
    <Grid x:Name="Root" Opacity="0">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image x:Name="Logo" Source="Assets/logo.png" Width="132" Height="132" RenderOptions.BitmapScalingMode="HighQuality"
                   RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <ScaleTransform x:Name="LogoScale" ScaleX="0.88" ScaleY="0.88"/>
                </Image.RenderTransform>
            </Image>
            <TextBlock Text="Tempo" FontSize="38" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"
                       Margin="0,22,0,0" FontFamily="Segoe UI Variable Display, Segoe UI"/>
            <TextBlock Text="Video and music, beautifully simple" FontSize="13" Foreground="#8F8F8F" HorizontalAlignment="Center"
                       Margin="0,6,0,0" FontFamily="Segoe UI Variable Text, Segoe UI"/>
            <Border Width="120" Height="3" CornerRadius="2" Background="#222222" Margin="0,34,0,0" ClipToBounds="True">
                <Border x:Name="Sweep" Width="44" HorizontalAlignment="Left" CornerRadius="2" Background="#5BB5FF">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="SweepMove" X="-44"/>
                    </Border.RenderTransform>
                </Border>
            </Border>
        </StackPanel>
    </Grid>
</Window>
