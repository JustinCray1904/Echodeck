<Window x:Class="EchoDeck.LyricsEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource EchoWindow}"
        Title="Edit lyrics"
        Width="720" Height="640" MinWidth="560" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <Grid Margin="24,0,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="SongText" FontSize="14" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="HintLine" Style="{StaticResource HintText}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Paste the lyrics, then play the song and press “Stamp line” (Ctrl+Enter) as each line starts. Timed lines look like [01:23.45] text."/>
        </StackPanel>

        <!-- tools -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,6">
            <Button Content="Paste" Style="{StaticResource FlatButton}" Padding="14,7" Margin="0,0,8,8" Click="Paste_Click"/>
            <Button Content="Play / Pause" Style="{StaticResource FlatButton}" Padding="14,7" Margin="0,0,8,8" Click="PlayPause_Click"/>
            <Button Content="−5 s" Style="{StaticResource FlatButton}" Padding="12,7" Margin="0,0,4,8" Click="SeekBack_Click"/>
            <Button Content="+5 s" Style="{StaticResource FlatButton}" Padding="12,7" Margin="0,0,8,8" Click="SeekForward_Click"/>
            <Button Content="Stamp line" Style="{StaticResource AccentButton}" Padding="14,7" Margin="0,0,8,8" Click="Stamp_Click"/>
            <Button Content="All −0.5 s" Style="{StaticResource FlatButton}" Padding="12,7" Margin="0,0,4,8" Click="ShiftEarlier_Click"/>
            <Button Content="All +0.5 s" Style="{StaticResource FlatButton}" Padding="12,7" Margin="0,0,8,8" Click="ShiftLater_Click"/>
            <Button Content="Remove times" Style="{StaticResource FlatButton}" Padding="12,7" Margin="0,0,8,8" Click="StripTimes_Click"/>
            <TextBlock x:Name="TimeText" VerticalAlignment="Center" Margin="4,0,0,8" FontSize="13"
                       Foreground="{DynamicResource MutedBrush}" Text="00:00.00"/>
        </WrapPanel>

        <TextBox x:Name="Editor" Grid.Row="2" AcceptsReturn="True" AcceptsTab="False" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontSize="14"
                 FontFamily="Cascadia Mono, Consolas" Padding="12,10"
                 Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}"
                 CaretBrush="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource SlateBrush}" BorderThickness="1"
                 SelectionBrush="{DynamicResource AccentBrush}" PreviewKeyDown="Editor_PreviewKeyDown"/>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,12,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Cancel" Style="{StaticResource FlatButton}" Padding="20,9" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
                <Button x:Name="SaveButton" Content="Save" Style="{StaticResource AccentButton}" Padding="24,9" Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
