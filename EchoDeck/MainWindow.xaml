<Window x:Class="EchoDeck.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="EchoDeck"
        Width="1180" Height="720" MinWidth="800" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        Icon="Assets/app.ico"
        AllowDrop="True"
        Loaded="Window_Loaded"
        Drop="Window_Drop">

    <!-- Custom title bar (the Figma "topbar"): the native caption is removed, the top 40px stays draggable. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid" Background="{DynamicResource BgBrush}" Focusable="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="58"/>
        </Grid.RowDefinitions>

        <!-- ===================== Top bar ===================== -->
        <Border x:Name="TopBar" Grid.Row="0" Background="{DynamicResource BgBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Image Source="Assets/app.ico" Width="18" Height="18" Margin="0,0,10,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Button x:Name="MenuButton" Style="{StaticResource FigmaIconButton}" Width="30" Height="28" ToolTip="Menu"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="MenuButton_Click">
                        <Path Style="{StaticResource Ico}" Data="{StaticResource IcoMore}"/>
                    </Button>
                    <ToggleButton x:Name="TopSidebarToggle" Style="{StaticResource FigmaIconToggle}" Width="30" Height="28"
                                  IsChecked="True" ToolTip="Show / hide side panel"
                                  shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="SidebarToggle_Click">
                        <Path Style="{StaticResource Ico}" Data="{StaticResource IcoSidebar}"/>
                    </ToggleButton>
                    <Border Width="1" Height="18" Background="{DynamicResource SlateBrush}" Margin="8,0,10,0"/>
                    <Path Style="{StaticResource Ico}" Data="{StaticResource IcoFolder}"
                          Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.3"/>
                    <TextBlock x:Name="BreadcrumbText" Margin="8,0,0,0" FontSize="13" MaxWidth="260"
                               Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Text="Library"/>
                </StackPanel>

                <TextBlock x:Name="TitleText" Grid.Column="0" Grid.ColumnSpan="3"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="330,0" MaxWidth="640" FontSize="14" Foreground="{DynamicResource MutedBrush}"
                           TextTrimming="CharacterEllipsis" IsHitTestVisible="False" Text="EchoDeck"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button Style="{StaticResource ChromeButton}" ToolTip="Minimize"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Minimize_Click">
                        <Path Style="{StaticResource Ico}" Data="{StaticResource IcoMinimize}"/>
                    </Button>
                    <Button Style="{StaticResource ChromeButton}" ToolTip="Maximize"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="MaximizeRestore_Click">
                        <Path x:Name="MaxIcon" Style="{StaticResource Ico}" Data="{StaticResource IcoMaximize}"/>
                    </Button>
                    <Button Style="{StaticResource ChromeButton}" ToolTip="Fullscreen (F11)"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Fullscreen_Click">
                        <Path Style="{StaticResource Ico}" Data="{StaticResource IcoFullscreen}"/>
                    </Button>
                    <Button Style="{StaticResource ChromeCloseButton}" ToolTip="Close"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click">
                        <Path Style="{StaticResource Ico}" Data="{StaticResource IcoClose}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== Rail + side panel + video ===================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Icon rail -->
            <Border x:Name="Rail" Grid.Column="0" Background="{DynamicResource RailBrush}">
                <Grid>
                    <StackPanel Margin="0,8,0,0" HorizontalAlignment="Center" VerticalAlignment="Top">
                        <ToggleButton x:Name="RailLibraryToggle" Style="{StaticResource FigmaIconToggle}"
                                      IsChecked="True" ToolTip="Library" Margin="0,0,0,6" Click="SidebarToggle_Click">
                            <Path Style="{StaticResource Ico}" Data="{StaticResource IcoHome}"/>
                        </ToggleButton>
                        <ToggleButton x:Name="RailVideosToggle" Style="{StaticResource FigmaIconToggle}"
                                      ToolTip="Show only videos" Margin="0,0,0,6" Click="RailFilter_Click">
                            <Path Style="{StaticResource Ico}" Data="{StaticResource IcoVideo}"/>
                        </ToggleButton>
                        <ToggleButton x:Name="RailMusicToggle" Style="{StaticResource FigmaIconToggle}"
                                      ToolTip="Show only music" Margin="0,0,0,6" Click="RailFilter_Click">
                            <Path Style="{StaticResource Ico}" Data="{StaticResource IcoMusic}"/>
                        </ToggleButton>
                        <Button Style="{StaticResource FigmaIconButton}" ToolTip="Open folder" Margin="0,0,0,6"
                                Click="OpenFolder_Click">
                            <Path Style="{StaticResource Ico}" Data="{StaticResource IcoFolder}"/>
                        </Button>
                        <Button Style="{StaticResource FigmaIconButton}" ToolTip="Open file (Ctrl+O)" Click="Open_Click">
                            <Path Style="{StaticResource Ico}" Data="{StaticResource IcoAdd}"/>
                        </Button>
                    </StackPanel>
                    <Button x:Name="RailSettingsButton" Style="{StaticResource FigmaIconButton}" ToolTip="Settings (Ctrl+,)"
                            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10"
                            Click="Settings_Click">
                        <Path Style="{StaticResource Ico}" Data="{StaticResource IcoSettings}"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Side panel: file browser + session queue (the queue lives in memory only, never saved) -->
            <Border x:Name="SidebarPanel" Grid.Column="1" Width="330" Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource RaisedBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="16,14,16,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Height="32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BrowserUpButton" Grid.Column="0" Style="{StaticResource FigmaIconButton}"
                                ToolTip="Up one folder" Click="BrowserUp_Click">
                            <Path Style="{StaticResource Ico}" Data="{StaticResource IcoUp}"/>
                        </Button>
                        <TextBlock x:Name="BrowserPathText" Grid.Column="1" Margin="6,0,6,0" FontSize="14"
                                   Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Text="Library"/>
                        <Button Grid.Column="2" Style="{StaticResource FigmaIconButton}" ToolTip="Add files to queue"
                                Click="AddFiles_Click">
                            <Path Style="{StaticResource Ico}" Data="{StaticResource IcoAdd}"/>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <TextBox x:Name="SearchBox" Style="{StaticResource DarkTextBox}" Padding="34,7,10,7"
                                 TextChanged="SearchBox_TextChanged"/>
                        <Path Style="{StaticResource Ico}" Data="{StaticResource IcoSearch}"
                              Stroke="{DynamicResource Fg3Brush}" HorizontalAlignment="Left" Margin="6,0,0,0"/>
                        <TextBlock x:Name="SearchPlaceholder" Text="Search" Margin="36,0,0,0" FontSize="13"
                                   Foreground="{DynamicResource Fg3Brush}" VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,12,0,0" Height="30">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <RadioButton x:Name="TabFiles" Style="{StaticResource SegmentButton}" Content="Files"
                                         GroupName="SideTab" IsChecked="True" Checked="SideTab_Checked"/>
                            <RadioButton x:Name="TabQueue" Style="{StaticResource SegmentButton}" Content="Queue"
                                         GroupName="SideTab" Checked="SideTab_Checked"/>
                        </StackPanel>
                        <TextBlock x:Name="CountText" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   FontSize="12" Foreground="{DynamicResource Fg3Brush}" Text="0 items"/>
                    </Grid>

                    <Grid Grid.Row="3">
                        <ListBox x:Name="BrowserList" Style="{StaticResource PlaylistList}"
                                 ItemContainerStyle="{StaticResource PlaylistItem}"
                                 MouseDoubleClick="BrowserList_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="32">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" Style="{StaticResource Ico}" Data="{Binding Icon}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" Margin="4,0,0,0"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <ListBox x:Name="QueueList" Style="{StaticResource PlaylistList}"
                                 ItemContainerStyle="{StaticResource PlaylistItem}" Visibility="Collapsed"
                                 MouseDoubleClick="QueueList_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="32">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" Style="{StaticResource Ico}" Data="{Binding Icon}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" Margin="4,0,0,0"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock x:Name="SideEmptyHint" TextWrapping="Wrap" TextAlignment="Center" FontSize="13"
                                   Foreground="{DynamicResource Fg3Brush}" HorizontalAlignment="Center"
                                   VerticalAlignment="Top" Margin="0,28,0,0" IsHitTestVisible="False"
                                   Text="Nothing here yet. Open a folder or drop files onto the window."/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Video area. VideoView is a native surface ("airspace"), so everything that must sit on top of the
                 picture (empty state, music view) is its Content. Anonymous Mode's pill lives in its own window. -->
            <Grid x:Name="VideoHost" Grid.Column="2" Background="Black">
                <vlc:VideoView x:Name="VideoView">
                    <Grid>
                        <!-- Empty state -->
                        <StackPanel x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                            <Image Source="Assets/app.ico" Width="84" Height="84"
                                   RenderOptions.BitmapScalingMode="HighQuality" Opacity="0.9"/>
                            <TextBlock Text="EchoDeck" FontSize="26" FontWeight="SemiBold" Margin="0,14,0,0"
                                       Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Open a file (Ctrl+O), choose a folder, or drop media here"
                                       FontSize="14" Margin="0,6,0,0" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource Fg3Brush}"/>
                        </StackPanel>

                        <!-- Music view (shown for audio files) -->
                        <Grid x:Name="MusicPanel" Visibility="Collapsed" Background="{DynamicResource PanelBrush}">
                            <Ellipse Width="720" Height="720" Opacity="0.22" HorizontalAlignment="Center"
                                     VerticalAlignment="Center" IsHitTestVisible="False">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                                        <GradientStop Color="#00000000" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>

                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid Width="340" Height="340" HorizontalAlignment="Center">
                                    <Ellipse x:Name="PulseRing" Width="320" Height="320" Stroke="{DynamicResource AccentBrush}"
                                             StrokeThickness="2" Opacity="0" RenderTransformOrigin="0.5,0.5"
                                             IsHitTestVisible="False">
                                        <Ellipse.RenderTransform>
                                            <ScaleTransform x:Name="PulseScale" ScaleX="1" ScaleY="1"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <Border Width="300" Height="300" CornerRadius="24" ClipToBounds="True">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                                                <GradientStop Color="{DynamicResource BgColor}" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Grid>
                                            <Ellipse Width="250" Height="250" Stroke="#44FFFFFF" StrokeThickness="1.5"/>
                                            <Ellipse Width="190" Height="190" Stroke="#55FFFFFF" StrokeThickness="1.5"/>
                                            <Ellipse Width="130" Height="130" Stroke="#66FFFFFF" StrokeThickness="1.5"/>
                                            <Path Data="{StaticResource IcoMusic}" Stretch="Uniform" Width="84" Height="84"
                                                  Stroke="White" StrokeThickness="1.6" StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="MusicTitle" FontSize="20" FontWeight="SemiBold" Margin="0,26,0,0"
                                           MaxWidth="560" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="MusicSubtitle" FontSize="14" Margin="0,6,0,0" MaxWidth="560"
                                           TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </vlc:VideoView>
            </Grid>
        </Grid>

        <!-- ===================== Control bar ===================== -->
        <Border x:Name="ControlBar" Grid.Row="2" Background="{DynamicResource BgBrush}" Padding="18,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- action bundle 1: previous | back | play | forward | next -->
                <Border Grid.Column="0" Style="{StaticResource Bundle}">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource BundleButton}" ToolTip="Previous (Shift+,)" Click="Previous_Click">
                            <Path Style="{StaticResource IcoFilled}" Data="{StaticResource IcoPrevious}"/>
                        </Button>
                        <Button Style="{StaticResource BundleButton}" ToolTip="Back (Left arrow)" Click="SkipBack_Click">
                            <Path Style="{StaticResource IcoFilled}" Data="{StaticResource IcoSeekBack}"/>
                        </Button>
                        <Button x:Name="PlayPauseButton" Style="{StaticResource PlayPillButton}" Margin="4,0"
                                ToolTip="Play / Pause (Space)" Click="PlayPause_Click">
                            <Path x:Name="PlayPauseIcon" Style="{StaticResource IcoFilled}" Data="{StaticResource IcoPlay}"/>
                        </Button>
                        <Button Style="{StaticResource BundleButton}" ToolTip="Forward (Right arrow)" Click="SkipFwd_Click">
                            <Path Style="{StaticResource IcoFilled}" Data="{StaticResource IcoSeekFwd}"/>
                        </Button>
                        <Button Style="{StaticResource BundleButton}" ToolTip="Next (Shift+.)" Click="Next_Click">
                            <Path Style="{StaticResource IcoFilled}" Data="{StaticResource IcoNext}"/>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- 00:02:10 [ seek bar ] 00:25:40 -->
                <Grid Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="72"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TimeText" Grid.Column="0" Text="00:00:00" FontSize="14"
                               Foreground="{DynamicResource MutedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <Slider x:Name="SeekSlider" Grid.Column="1" Style="{StaticResource FigmaSlider}"
                            Minimum="0" Maximum="1000" IsMoveToPointEnabled="True" Margin="6,0"
                            PreviewMouseDown="SeekSlider_PreviewMouseDown"
                            PreviewMouseUp="SeekSlider_PreviewMouseUp"
                            ValueChanged="SeekSlider_ValueChanged"/>

                    <TextBlock x:Name="DurationText" Grid.Column="2" Text="00:00:00" FontSize="14"
                               Foreground="{DynamicResource MutedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <!-- volume -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Button x:Name="VolumeButton" Style="{StaticResource FigmaIconButton}" Margin="0,0,6,0"
                            ToolTip="Mute (M)" Click="Volume_Click">
                        <Path x:Name="VolumeIcon" Style="{StaticResource Ico}" Data="{StaticResource IcoVolume}"/>
                    </Button>
                    <Slider x:Name="VolumeSlider" Width="96" Style="{StaticResource FigmaSlider}"
                            Minimum="0" Maximum="100" Value="80" IsMoveToPointEnabled="True"
                            ValueChanged="VolumeSlider_ValueChanged"/>
                </StackPanel>

                <!-- action bundle 2: audio | subtitles | settings -->
                <Border Grid.Column="3" Style="{StaticResource Bundle}" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="AudioButton" Style="{StaticResource BundleButton}" ToolTip="Audio track (B)"
                                Click="Audio_Click">
                            <Path Style="{StaticResource Ico}" Data="{StaticResource IcoAudio}"/>
                        </Button>
                        <Button x:Name="SubtitleButton" Style="{StaticResource BundleButton}" ToolTip="Subtitles (V)"
                                Click="Subtitle_Click">
                            <Path Style="{StaticResource Ico}" Data="{StaticResource IcoSubtitles}"/>
                        </Button>
                        <Button x:Name="SettingsButton" Style="{StaticResource BundleButton}" ToolTip="Settings (Ctrl+,)"
                                Click="Settings_Click">
                            <Path Style="{StaticResource Ico}" Data="{StaticResource IcoSettings}"/>
                        </Button>
                    </StackPanel>
                </Border>

                <ToggleButton x:Name="ControlsPlaylistToggle" Grid.Column="4" Style="{StaticResource FigmaIconToggle}"
                              IsChecked="True" ToolTip="Side panel (Q)" VerticalAlignment="Center"
                              Click="SidebarToggle_Click">
                    <Path Style="{StaticResource Ico}" Data="{StaticResource IcoPlaylist}"/>
                </ToggleButton>
            </Grid>
        </Border>
    </Grid>
</Window>
