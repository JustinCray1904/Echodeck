<Window x:Class="EchoDeck.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:EchoDeck"
        Title="EchoDeck"
        Width="1240" Height="760" MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        Icon="Assets/app.ico"
        AllowDrop="True"
        Loaded="Window_Loaded"
        Drop="Window_Drop">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ItemsPanelTemplate x:Key="GridPanel"><WrapPanel/></ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="ListPanel"><StackPanel/></ItemsPanelTemplate>

        <!-- Library tile (grid view): thumbnail + name -->
        <DataTemplate x:Key="GridTpl">
            <StackPanel Width="200" Margin="0,0,14,14">
                <Border Width="200" Height="112" CornerRadius="10" Background="{DynamicResource RaisedBrush}">
                    <Grid>
                        <Path Style="{StaticResource Ico}" Data="{Binding Icon}" Stroke="{DynamicResource Fg3Brush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform><ScaleTransform ScaleX="1.7" ScaleY="1.7"/></Path.RenderTransform>
                        </Path>
                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill">
                            <Image.Clip><RectangleGeometry Rect="0,0,200,112" RadiusX="10" RadiusY="10"/></Image.Clip>
                        </Image>
                    </Grid>
                </Border>
                <TextBlock Text="{Binding Name}" Margin="2,8,2,0" FontSize="13" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DataTemplate>

        <!-- Library row (list view) -->
        <DataTemplate x:Key="ListTpl">
            <Grid Height="44">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="56" Height="34" CornerRadius="6" Background="{DynamicResource RaisedBrush}" HorizontalAlignment="Left">
                    <Grid>
                        <Path Style="{StaticResource Ico}" Data="{Binding Icon}" Stroke="{DynamicResource Fg3Brush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform><ScaleTransform ScaleX="0.8" ScaleY="0.8"/></Path.RenderTransform>
                        </Path>
                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill">
                            <Image.Clip><RectangleGeometry Rect="0,0,56,34" RadiusX="6" RadiusY="6"/></Image.Clip>
                        </Image>
                    </Grid>
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>
        </DataTemplate>

        <!-- Queue row -->
        <DataTemplate x:Key="QueueTpl">
            <Grid Height="34">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Path Style="{StaticResource Ico}" Data="{Binding Icon}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" Margin="4,0,0,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="{DynamicResource BgBrush}" Focusable="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="58"/>
        </Grid.RowDefinitions>

        <!-- ===================== Top bar ===================== -->
        <Border x:Name="TopBar" Grid.Row="0" Background="{DynamicResource BgBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Image Source="Assets/app.ico" Width="18" Height="18" Margin="0,0,10,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Button x:Name="MenuButton" Style="{StaticResource FigmaIconButton}" Width="30" Height="28" ToolTip="Menu"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="MenuButton_Click">
                        <Path Style="{StaticResource Ico}" Data="{StaticResource IcoMore}"/>
                    </Button>
                    <ToggleButton x:Name="TopSidebarToggle" Style="{StaticResource FigmaIconToggle}" Width="30" Height="28"
                                  ToolTip="Show / hide playlist panel"
                                  shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="SidebarToggle_Click">
                        <Path Style="{StaticResource Ico}" Data="{StaticResource IcoSidebar}"/>
                    </ToggleButton>
                    <Border Width="1" Height="18" Background="{DynamicResource SlateBrush}" Margin="8,0,10,0"/>
                    <Path Style="{StaticResource Ico}" Data="{StaticResource IcoFolder}"
                          Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.3"/>
                    <TextBlock x:Name="BreadcrumbText" Margin="8,0,0,0" FontSize="13" MaxWidth="260"
                               Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Text="Library"/>
                </StackPanel>

                <TextBlock x:Name="TitleText" Grid.Column="0" Grid.ColumnSpan="3"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="330,0" MaxWidth="640" FontSize="14" Foreground="{DynamicResource MutedBrush}"
                           TextTrimming="CharacterEllipsis" IsHitTestVisible="False" Text="EchoDeck"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button Style="{StaticResource ChromeButton}" ToolTip="Minimize"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Minimize_Click">
                        <Path Style="{StaticResource Ico}" Data="{StaticResource IcoMinimize}"/>
                    </Button>
                    <Button Style="{StaticResource ChromeButton}" ToolTip="Maximize"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="MaximizeRestore_Click">
                        <Path x:Name="MaxIcon" Style="{StaticResource Ico}" Data="{StaticResource IcoMaximize}"/>
                    </Button>
                    <Button Style="{StaticResource ChromeButton}" ToolTip="Fullscreen (F11)"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Fullscreen_Click">
                        <Path Style="{StaticResource Ico}" Data="{StaticResource IcoFullscreen}"/>
                    </Button>
                    <Button Style="{StaticResource ChromeCloseButton}" ToolTip="Close"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click">
                        <Path Style="{StaticResource Ico}" Data="{StaticResource IcoClose}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== Navigation + content ===================== -->
        <Grid x:Name="ContentGrid" Grid.Row="1" Margin="8,0,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Figma nav: Home / Videos / Music / Playlist / Add item (labels hide when a video is showing) -->
            <Border x:Name="Rail" Grid.Column="0" Width="190" Background="{DynamicResource PanelBrush}"
                    CornerRadius="10" Padding="8" Margin="0,0,8,0">
                <StackPanel>
                    <RadioButton x:Name="NavHome" Style="{StaticResource RailItem}" Content="Home" ToolTip="Home"
                                 Tag="{StaticResource IcoHome}" GroupName="Nav" IsChecked="True" Click="Nav_Click"/>
                    <RadioButton x:Name="NavVideos" Style="{StaticResource RailItem}" Content="Videos" ToolTip="Videos"
                                 Tag="{StaticResource IcoVideo}" GroupName="Nav" Click="Nav_Click"/>
                    <RadioButton x:Name="NavMusic" Style="{StaticResource RailItem}" Content="Music" ToolTip="Music"
                                 Tag="{StaticResource IcoMusic}" GroupName="Nav" Click="Nav_Click"/>
                    <RadioButton x:Name="NavQueue" Style="{StaticResource RailItem}" Content="Playlist" ToolTip="Playlist (Q)"
                                 Tag="{StaticResource IcoPlaylist}" GroupName="Nav" Click="Nav_Click"/>
                    <RadioButton x:Name="NavAdd" Style="{StaticResource RailItem}" Content="Add item" ToolTip="Add item"
                                 Tag="{StaticResource IcoAdd}" GroupName="NavAdd" Click="NavAdd_Click"/>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1">
                <!-- ================= Library view ================= -->
                <Grid x:Name="LibraryView">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="54"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="4,0,4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="LibBackButton" Grid.Column="0" Style="{StaticResource FigmaIconButton}" ToolTip="Back" Click="LibBack_Click">
                            <Path Style="{StaticResource Ico}" Data="{StaticResource IcoBack}"/>
                        </Button>
                        <Button x:Name="LibForwardButton" Grid.Column="1" Style="{StaticResource FigmaIconButton}" ToolTip="Forward" Click="LibForward_Click">
                            <Path Style="{StaticResource Ico}" Data="{StaticResource IcoForward}"/>
                        </Button>
                        <TextBlock x:Name="LibPathText" Grid.Column="2" Margin="12,0" FontSize="15" FontWeight="SemiBold"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="Home"/>
                        <TextBlock x:Name="CountText" Grid.Column="3" Margin="0,0,12,0" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Fg3Brush}" Text="0 items"/>
                        <Button Grid.Column="4" Style="{StaticResource FigmaIconButton}" ToolTip="Sort A–Z / Z–A" Click="Sort_Click">
                            <Path Style="{StaticResource Ico}" Data="{StaticResource IcoSort}"/>
                        </Button>
                        <Button Grid.Column="5" Style="{StaticResource FigmaIconButton}" ToolTip="Grid / list view" Click="ViewToggle_Click">
                            <Path x:Name="ViewToggleIcon" Style="{StaticResource Ico}" Data="{StaticResource IcoList}"/>
                        </Button>
                        <Grid Grid.Column="6" Width="230" Margin="8,0,6,0">
                            <TextBox x:Name="SearchBox" Style="{StaticResource DarkTextBox}" Padding="34,6,10,6"
                                     TextChanged="SearchBox_TextChanged"/>
                            <Path Style="{StaticResource Ico}" Data="{StaticResource IcoSearch}"
                                  Stroke="{DynamicResource Fg3Brush}" HorizontalAlignment="Left" Margin="6,0,0,0"/>
                            <TextBlock x:Name="SearchPlaceholder" Text="Search" Margin="36,0,0,0" FontSize="13"
                                       Foreground="{DynamicResource Fg3Brush}" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>
                        <Button Grid.Column="7" Style="{StaticResource FigmaIconButton}" ToolTip="Menu" Click="MenuButton_Click">
                            <Path Style="{StaticResource Ico}" Data="{StaticResource IcoMore}"/>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Border Height="1" VerticalAlignment="Top" Background="{DynamicResource RaisedBrush}"/>
                        <ListBox x:Name="BrowserList" Style="{StaticResource PlaylistList}"
                                 ItemContainerStyle="{StaticResource PlaylistItem}" Margin="0,10,0,0"
                                 ItemTemplate="{StaticResource GridTpl}" ItemsPanel="{StaticResource GridPanel}"
                                 MouseDoubleClick="BrowserList_MouseDoubleClick"/>
                        <TextBlock x:Name="LibEmptyHint" TextWrapping="Wrap" TextAlignment="Center" FontSize="14"
                                   Foreground="{DynamicResource Fg3Brush}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" IsHitTestVisible="False"
                                   Text="Nothing here yet. Choose a media folder from the menu, or drop files onto the window."/>

                        <!-- mini player (Figma: bottom-right while browsing) -->
                        <Border x:Name="MiniPlayer" Visibility="Collapsed" Width="300" HorizontalAlignment="Right"
                                VerticalAlignment="Bottom" Margin="0,0,6,6" Padding="12"
                                Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource SlateBrush}"
                                BorderThickness="1" CornerRadius="12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Style="{StaticResource PlayPillButton}" Width="40" Height="30"
                                            Click="PlayPause_Click">
                                        <Path x:Name="MiniPlayIcon" Style="{StaticResource IcoFilled}" Data="{StaticResource IcoPlay}"/>
                                    </Button>
                                    <TextBlock x:Name="MiniTitle" Grid.Column="1" Margin="12,0" FontSize="13" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="2" Style="{StaticResource FigmaIconButton}" ToolTip="Open player"
                                            Click="MiniExpand_Click">
                                        <Path Style="{StaticResource Ico}" Data="{StaticResource IcoFullscreen}"/>
                                    </Button>
                                </Grid>
                                <Border Height="6" CornerRadius="3" Margin="0,10,0,0" Background="{DynamicResource TrackBrush}">
                                    <Border x:Name="MiniProgress" Width="0" HorizontalAlignment="Left" CornerRadius="3"
                                            Background="{DynamicResource AccentBrush}"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ================= Player view ================= -->
                <Grid x:Name="PlayerView">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- playlist panel (Figma sidebar) -->
                    <Border x:Name="SidebarPanel" Grid.Column="0" Width="310" Margin="0,0,8,0"
                            Background="{DynamicResource PanelBrush}" CornerRadius="10">
                        <Grid Margin="16,14,16,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Height="30">
                                <TextBlock Text="Playlist" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button HorizontalAlignment="Right" Style="{StaticResource FigmaIconButton}" ToolTip="Add files"
                                        Click="AddFiles_Click">
                                    <Path Style="{StaticResource Ico}" Data="{StaticResource IcoAdd}"/>
                                </Button>
                            </Grid>
                            <TextBlock x:Name="QueueCount" Grid.Row="1" Margin="0,2,0,0" FontSize="12"
                                       Foreground="{DynamicResource Fg3Brush}" Text="0 items"/>
                            <Grid Grid.Row="2">
                                <ListBox x:Name="QueueList" Style="{StaticResource PlaylistList}"
                                         ItemContainerStyle="{StaticResource PlaylistItem}"
                                         ItemTemplate="{StaticResource QueueTpl}"
                                         MouseDoubleClick="QueueList_MouseDoubleClick"/>
                                <TextBlock x:Name="SideEmptyHint" TextWrapping="Wrap" TextAlignment="Center" FontSize="13"
                                           Foreground="{DynamicResource Fg3Brush}" HorizontalAlignment="Center"
                                           VerticalAlignment="Top" Margin="0,28,0,0" IsHitTestVisible="False"
                                           Text="The playlist is empty. Double-click a file in the library to start playing."/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Video area. VideoView is a native surface ("airspace"), so everything that must sit on top of the
                         picture (empty state, music view) is its Content. -->
                    <Grid x:Name="VideoHost" Grid.Column="1" Background="Black">
                        <vlc:VideoView x:Name="VideoView">
                            <Grid x:Name="VideoSurface" Background="#01000000"
                                  MouseLeftButtonDown="VideoSurface_MouseLeftButtonDown"
                                  MouseRightButtonUp="VideoSurface_MouseRightButtonUp">
                                <StackPanel x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            IsHitTestVisible="False">
                                    <Image Source="Assets/app.ico" Width="84" Height="84"
                                           RenderOptions.BitmapScalingMode="HighQuality" Opacity="0.9"/>
                                    <TextBlock Text="EchoDeck" FontSize="26" FontWeight="SemiBold" Margin="0,14,0,0"
                                               Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Pick something from the library to start playing"
                                               FontSize="14" Margin="0,6,0,0" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource Fg3Brush}"/>
                                </StackPanel>

                                <Grid x:Name="MusicPanel" Visibility="Collapsed" Background="{DynamicResource PanelBrush}">
                                    <Ellipse Width="720" Height="720" Opacity="0.22" HorizontalAlignment="Center"
                                             VerticalAlignment="Center" IsHitTestVisible="False">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush>
                                                <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                                                <GradientStop Color="#00000000" Offset="1"/>
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <Grid Width="340" Height="340" HorizontalAlignment="Center">
                                            <Ellipse x:Name="PulseRing" Width="320" Height="320" Stroke="{DynamicResource AccentBrush}"
                                                     StrokeThickness="2" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                                <Ellipse.RenderTransform>
                                                    <ScaleTransform x:Name="PulseScale" ScaleX="1" ScaleY="1"/>
                                                </Ellipse.RenderTransform>
                                            </Ellipse>
                                            <Border Width="300" Height="300" CornerRadius="24" ClipToBounds="True">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                                                        <GradientStop Color="{DynamicResource BgColor}" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Grid>
                                                    <Ellipse Width="250" Height="250" Stroke="#44FFFFFF" StrokeThickness="1.5"/>
                                                    <Ellipse Width="190" Height="190" Stroke="#55FFFFFF" StrokeThickness="1.5"/>
                                                    <Ellipse Width="130" Height="130" Stroke="#66FFFFFF" StrokeThickness="1.5"/>
                                                    <Image x:Name="MusicCover" Stretch="UniformToFill"/>
                                                    <Path x:Name="MusicGlyph" Data="{StaticResource IcoMusic}" Stretch="Uniform" Width="84" Height="84"
                                                          Stroke="White" StrokeThickness="1.6" StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                        <TextBlock x:Name="MusicTitle" FontSize="20" FontWeight="SemiBold" Margin="0,26,0,0"
                                                   MaxWidth="560" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="MusicSubtitle" FontSize="14" Margin="0,6,0,0" MaxWidth="560"
                                                   TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </vlc:VideoView>
                    </Grid>

                    <!-- quick settings panel (Figma: Video / Audio / Subtitles side panel) -->
                    <Border x:Name="QuickPanel" Grid.Column="2" Width="372" Margin="8,0,0,0" Visibility="Collapsed"
                            Background="{DynamicResource PanelBrush}" CornerRadius="10">
                        <Grid Margin="18,14,18,14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Height="34">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="QTabVideo" Style="{StaticResource SegmentButton}" Content="Video" GroupName="QTab" IsChecked="True" Checked="QTab_Checked"/>
                                    <RadioButton x:Name="QTabAudio" Style="{StaticResource SegmentButton}" Content="Audio" GroupName="QTab" Checked="QTab_Checked"/>
                                    <RadioButton x:Name="QTabSubs" Style="{StaticResource SegmentButton}" Content="Subtitles" GroupName="QTab" Checked="QTab_Checked"/>
                                </StackPanel>
                                <Button HorizontalAlignment="Right" Style="{StaticResource FigmaIconButton}" Click="QuickClose_Click">
                                    <Path Style="{StaticResource Ico}" Data="{StaticResource IcoClose}"/>
                                </Button>
                            </Grid>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                                <Grid>
                                    <StackPanel x:Name="QPageVideo">
                                        <TextBlock Text="Picture" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                                        <Grid Margin="0,0,0,14">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Hue" Style="{StaticResource HintText}" Margin="0,0,0,6"/>
                                <TextBlock x:Name="QHueValue" Grid.Column="1" Style="{StaticResource HintText}"/>
                                <Slider x:Name="QHue" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource FigmaSlider}"
                                        Minimum="-180" Maximum="180" IsMoveToPointEnabled="True" ValueChanged="QuickSlider_Changed"/>
                            </Grid>
                                        <Grid Margin="0,0,0,14">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Brightness" Style="{StaticResource HintText}" Margin="0,0,0,6"/>
                                <TextBlock x:Name="QBrightnessValue" Grid.Column="1" Style="{StaticResource HintText}"/>
                                <Slider x:Name="QBrightness" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource FigmaSlider}"
                                        Minimum="0" Maximum="2" IsMoveToPointEnabled="True" ValueChanged="QuickSlider_Changed"/>
                            </Grid>
                                        <Grid Margin="0,0,0,14">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Contrast" Style="{StaticResource HintText}" Margin="0,0,0,6"/>
                                <TextBlock x:Name="QContrastValue" Grid.Column="1" Style="{StaticResource HintText}"/>
                                <Slider x:Name="QContrast" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource FigmaSlider}"
                                        Minimum="0" Maximum="2" IsMoveToPointEnabled="True" ValueChanged="QuickSlider_Changed"/>
                            </Grid>
                                        <Grid Margin="0,0,0,14">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Saturation" Style="{StaticResource HintText}" Margin="0,0,0,6"/>
                                <TextBlock x:Name="QSaturationValue" Grid.Column="1" Style="{StaticResource HintText}"/>
                                <Slider x:Name="QSaturation" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource FigmaSlider}"
                                        Minimum="0" Maximum="3" IsMoveToPointEnabled="True" ValueChanged="QuickSlider_Changed"/>
                            </Grid>
                                        <Grid Margin="0,0,0,14">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Gamma" Style="{StaticResource HintText}" Margin="0,0,0,6"/>
                                <TextBlock x:Name="QGammaValue" Grid.Column="1" Style="{StaticResource HintText}"/>
                                <Slider x:Name="QGamma" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource FigmaSlider}"
                                        Minimum="0.1" Maximum="4" IsMoveToPointEnabled="True" ValueChanged="QuickSlider_Changed"/>
                            </Grid>
                                        <Button Content="Reset picture" Style="{StaticResource FlatButton}" HorizontalAlignment="Left"
                                                Margin="0,0,0,18" Click="QuickReset_Click"/>
                                        <TextBlock Text="Aspect ratio" Style="{StaticResource HintText}" Margin="0,0,0,6"/>
                            <ComboBox x:Name="QAspectCombo" Style="{StaticResource EchoCombo}" Margin="0,0,0,16" SelectionChanged="QuickCombo_Changed"/>
                                        <TextBlock Text="Playback speed" Style="{StaticResource HintText}" Margin="0,0,0,6"/>
                            <ComboBox x:Name="QSpeedCombo" Style="{StaticResource EchoCombo}" Margin="0,0,0,16" SelectionChanged="QuickCombo_Changed"/>
                                    </StackPanel>

                                    <StackPanel x:Name="QPageAudio" Visibility="Collapsed">
                                        <TextBlock Text="Audio" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                                        <TextBlock Text="Audio track" Style="{StaticResource HintText}" Margin="0,0,0,6"/>
                            <ComboBox x:Name="QAudioCombo" Style="{StaticResource EchoCombo}" Margin="0,0,0,16" SelectionChanged="QuickCombo_Changed"/>
                                        <TextBlock x:Name="QAudioHint" Style="{StaticResource HintText}"/>
                                    </StackPanel>

                                    <StackPanel x:Name="QPageSubs" Visibility="Collapsed">
                                        <TextBlock Text="Subtitles" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                                        <TextBlock Text="Subtitle track" Style="{StaticResource HintText}" Margin="0,0,0,6"/>
                            <ComboBox x:Name="QSubCombo" Style="{StaticResource EchoCombo}" Margin="0,0,0,16" SelectionChanged="QuickCombo_Changed"/>
                                        <Button x:Name="QAddSubButton" Content="Add subtitle file…" Style="{StaticResource FlatButton}"
                                                HorizontalAlignment="Left" Click="QuickAddSub_Click"/>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>

                            <Button Grid.Row="2" Content="All settings…" Style="{StaticResource FlatButton}" Margin="0,10,0,0"
                                    Click="AllSettings_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ===================== Control bar ===================== -->
        <Border x:Name="ControlBar" Grid.Row="2" Background="{DynamicResource BgBrush}" Padding="18,0" Visibility="Collapsed">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- action bundle 1: previous | back | play | forward | next -->
                <Border Grid.Column="0" Style="{StaticResource Bundle}">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="PrevButton" Style="{StaticResource BundleButton}" ToolTip="Previous (Shift+,)" Click="Previous_Click">
                            <Path Style="{StaticResource IcoFilled}" Data="{StaticResource IcoPrevious}"/>
                        </Button>
                        <Button x:Name="BackButton" Style="{StaticResource BundleButton}" ToolTip="Back (Left arrow)" Click="SkipBack_Click">
                            <Path Style="{StaticResource IcoFilled}" Data="{StaticResource IcoSeekBack}"/>
                        </Button>
                        <Button x:Name="PlayPauseButton" Style="{StaticResource PlayPillButton}" Margin="4,0"
                                ToolTip="Play / Pause (Space)" Click="PlayPause_Click">
                            <Path x:Name="PlayPauseIcon" Style="{StaticResource IcoFilled}" Data="{StaticResource IcoPlay}"/>
                        </Button>
                        <Button x:Name="FwdButton" Style="{StaticResource BundleButton}" ToolTip="Forward (Right arrow)" Click="SkipFwd_Click">
                            <Path Style="{StaticResource IcoFilled}" Data="{StaticResource IcoSeekFwd}"/>
                        </Button>
                        <Button x:Name="NextButton" Style="{StaticResource BundleButton}" ToolTip="Next (Shift+.)" Click="Next_Click">
                            <Path Style="{StaticResource IcoFilled}" Data="{StaticResource IcoNext}"/>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- 00:02:10 [ seek bar | waveform ] 00:25:40 -->
                <Grid Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="72"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TimeText" Grid.Column="0" Text="00:00:00" FontSize="14"
                               Foreground="{DynamicResource MutedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <Slider x:Name="SeekSlider" Grid.Column="1" Style="{StaticResource FigmaSlider}"
                            Minimum="0" Maximum="1000" IsMoveToPointEnabled="True" Margin="6,0" IsEnabled="False"
                            PreviewMouseDown="SeekSlider_PreviewMouseDown"
                            PreviewMouseUp="SeekSlider_PreviewMouseUp"
                            ValueChanged="SeekSlider_ValueChanged"/>
                    <local:WaveformBar x:Name="WaveBar" Grid.Column="1" Height="38" Margin="6,0" Visibility="Collapsed"/>

                    <TextBlock x:Name="DurationText" Grid.Column="2" Text="00:00:00" FontSize="14"
                               Foreground="{DynamicResource MutedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <!-- shuffle / repeat -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <ToggleButton x:Name="ShuffleToggle" Style="{StaticResource FigmaIconToggle}" ToolTip="Shuffle"
                                  Click="Shuffle_Click">
                        <Path Style="{StaticResource Ico}" Data="{StaticResource IcoShuffle}"/>
                    </ToggleButton>
                    <Button x:Name="LoopButton" Style="{StaticResource FigmaIconButton}" ToolTip="Repeat: off" Click="Loop_Click">
                        <Grid>
                            <Path x:Name="LoopIcon" Style="{StaticResource Ico}" Data="{StaticResource IcoRepeat}"/>
                            <TextBlock x:Name="LoopBadge" Text="1" FontSize="9" FontWeight="Bold" Visibility="Collapsed"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- volume: VLC-style wedge -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Button x:Name="VolumeButton" Style="{StaticResource FigmaIconButton}" Margin="0,0,6,0"
                            ToolTip="Mute (M)" Click="Volume_Click">
                        <Path x:Name="VolumeIcon" Style="{StaticResource Ico}" Data="{StaticResource IcoVolume}"/>
                    </Button>
                    <Slider x:Name="VolumeSlider" Style="{StaticResource WedgeSlider}"
                            Minimum="0" Maximum="100" Value="80" IsMoveToPointEnabled="True"
                            ValueChanged="VolumeSlider_ValueChanged"/>
                </StackPanel>

                <!-- action bundle 2: audio | subtitles | settings (each opens the quick settings panel) -->
                <Border Grid.Column="4" Style="{StaticResource Bundle}" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="AudioButton" Style="{StaticResource BundleButton}" ToolTip="Audio (B cycles tracks)"
                                Click="Audio_Click">
                            <Path Style="{StaticResource Ico}" Data="{StaticResource IcoAudio}"/>
                        </Button>
                        <Button x:Name="SubtitleButton" Style="{StaticResource BundleButton}" ToolTip="Subtitles (V cycles tracks)"
                                Click="Subtitle_Click">
                            <Path Style="{StaticResource Ico}" Data="{StaticResource IcoSubtitles}"/>
                        </Button>
                        <Button x:Name="SettingsButton" Style="{StaticResource BundleButton}" ToolTip="Video settings"
                                Click="Settings_Click">
                            <Path Style="{StaticResource Ico}" Data="{StaticResource IcoSettings}"/>
                        </Button>
                    </StackPanel>
                </Border>

                <ToggleButton x:Name="ControlsPlaylistToggle" Grid.Column="5" Style="{StaticResource FigmaIconToggle}"
                              ToolTip="Playlist (Q)" VerticalAlignment="Center" Click="SidebarToggle_Click">
                    <Path Style="{StaticResource Ico}" Data="{StaticResource IcoPlaylist}"/>
                </ToggleButton>
            </Grid>
        </Border>
    </Grid>
</Window>
