<Window x:Class="EchoDeck.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:EchoDeck"
        Title="EchoDeck"
        Width="1240" Height="760" MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        Icon="Assets/app.ico"
        AllowDrop="True"
        Loaded="Window_Loaded"
        Drop="Window_Drop">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <local:RatioConverter x:Key="Ratio"/>

        <LinearGradientBrush x:Key="CoverFallback" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
            <GradientStop Color="{DynamicResource BgColor}" Offset="1"/>
        </LinearGradientBrush>

        <!-- Library tile (grid view): rounded thumbnail, hover play / more buttons, name + info -->
        <DataTemplate x:Key="TileTpl">
            <Border Margin="0,0,16,20" Background="Transparent" Cursor="Hand"
                    Loaded="Tile_Loaded" Unloaded="Tile_Unloaded"
                    MouseLeftButtonDown="Tile_MouseDown" MouseRightButtonUp="Tile_RightClick">
                <StackPanel>
                    <Border CornerRadius="14" BorderThickness="2" Background="{DynamicResource RaisedBrush}"
                            Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource Ratio}, ConverterParameter=0.5625}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Path Style="{StaticResource Ico}" Data="{Binding Icon}" Stroke="{DynamicResource Fg3Brush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform><ScaleTransform ScaleX="1.8" ScaleY="1.8"/></Path.RenderTransform>
                            </Path>
                            <Rectangle RadiusX="12" RadiusY="12">
                                <Rectangle.Fill>
                                    <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Rectangle RadiusX="12" RadiusY="12" Fill="#55000000"/>
                                <Button Style="{StaticResource TileRoundButton}" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                        Margin="10" ToolTip="Play" Click="TilePlay_Click">
                                    <Path Style="{StaticResource IcoFilled}" Data="{StaticResource IcoPlay}"/>
                                </Button>
                                <Button Style="{StaticResource TileRoundButton}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Margin="10" ToolTip="More options" Click="TileMore_Click">
                                    <Path Style="{StaticResource Ico}" Data="{StaticResource IcoMore}"/>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding Name}" Margin="3,10,3,0" FontSize="13" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Subtitle}" Margin="3,2,3,0" FontSize="12" Foreground="{DynamicResource Fg3Brush}"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSubtitle}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Grid view row: exactly four tiles per row -->
        <DataTemplate x:Key="RowGridTpl">
            <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource TileTpl}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DataTemplate>

        <!-- List view row -->
        <DataTemplate x:Key="ListItemTpl">
            <Border Height="54" Margin="0,0,0,4" CornerRadius="10" Cursor="Hand"
                    Loaded="Tile_Loaded" Unloaded="Tile_Unloaded"
                    MouseLeftButtonDown="Tile_MouseDown" MouseRightButtonUp="Tile_RightClick">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentDimBrush}"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource RaisedBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Margin="8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="72" Height="40" CornerRadius="8" Background="{DynamicResource RaisedBrush}" HorizontalAlignment="Left">
                        <Grid>
                            <Path Style="{StaticResource Ico}" Data="{Binding Icon}" Stroke="{DynamicResource Fg3Brush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Rectangle RadiusX="8" RadiusY="8">
                                <Rectangle.Fill><ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill"/></Rectangle.Fill>
                            </Rectangle>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource Fg3Brush}" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSubtitle}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource FigmaIconButton}" ToolTip="More options" Click="TileMore_Click">
                        <Path Style="{StaticResource Ico}" Data="{StaticResource IcoMore}"/>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="RowListTpl">
            <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource ListItemTpl}" Focusable="False"/>
        </DataTemplate>

        <!-- Side panel row (queue / playlists / playlist tracks) -->
        <DataTemplate x:Key="SideTpl">
            <Border Background="Transparent" MouseRightButtonUp="SideItem_RightClick" Loaded="Tile_Loaded" Unloaded="Tile_Unloaded">
                <Grid Height="44">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Style="{StaticResource Ico}" Data="{Binding Icon}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0">
                        <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource Fg3Brush}" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSubtitle}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="{DynamicResource BgBrush}" Focusable="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===================== Top bar ===================== -->
        <Border x:Name="TopBar" Grid.Row="0" Height="40" Background="{DynamicResource BgBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Image Source="Assets/app.ico" Width="18" Height="18" Margin="0,0,10,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Button x:Name="MenuButton" Style="{StaticResource FigmaIconButton}" Width="30" Height="28" ToolTip="Menu"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="MenuButton_Click">
                        <Path Style="{StaticResource Ico}" Data="{StaticResource IcoMore}"/>
                    </Button>
                    <ToggleButton x:Name="TopSidebarToggle" Style="{StaticResource FigmaIconToggle}" Width="30" Height="28"
                                  ToolTip="Queue / playlist panel (Q, P)"
                                  shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="SidebarToggle_Click">
                        <Path Style="{StaticResource Ico}" Data="{StaticResource IcoSidebar}"/>
                    </ToggleButton>
                    <Border Width="1" Height="18" Background="{DynamicResource SlateBrush}" Margin="8,0,10,0"/>
                    <Path Style="{StaticResource Ico}" Data="{StaticResource IcoFolder}"
                          Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.3"/>
                    <TextBlock x:Name="BreadcrumbText" Margin="8,0,0,0" FontSize="13" MaxWidth="260"
                               Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Text="Library"/>
                </StackPanel>

                <TextBlock x:Name="TitleText" Grid.Column="0" Grid.ColumnSpan="3"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="330,0" MaxWidth="640" FontSize="14" Foreground="{DynamicResource MutedBrush}"
                           TextTrimming="CharacterEllipsis" IsHitTestVisible="False" Text="EchoDeck"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button Style="{StaticResource ChromeButton}" ToolTip="Minimize"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Minimize_Click">
                        <Path Style="{StaticResource Ico}" Data="{StaticResource IcoMinimize}"/>
                    </Button>
                    <Button Style="{StaticResource ChromeButton}" ToolTip="Maximize"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="MaximizeRestore_Click">
                        <Path x:Name="MaxIcon" Style="{StaticResource Ico}" Data="{StaticResource IcoMaximize}"/>
                    </Button>
                    <Button Style="{StaticResource ChromeButton}" ToolTip="Fullscreen (F11)"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Fullscreen_Click">
                        <Path Style="{StaticResource Ico}" Data="{StaticResource IcoFullscreen}"/>
                    </Button>
                    <Button Style="{StaticResource ChromeCloseButton}" ToolTip="Close"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click">
                        <Path Style="{StaticResource Ico}" Data="{StaticResource IcoClose}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== Navigation + content ===================== -->
        <Grid x:Name="ContentGrid" Grid.Row="1" Margin="8,0,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="Rail" Grid.Column="0" Width="190" Background="{DynamicResource PanelBrush}"
                    CornerRadius="12" Padding="8" Margin="0,0,8,0">
                <StackPanel>
                    <RadioButton x:Name="NavRecent" Style="{StaticResource RailItem}" Content="Recent" ToolTip="Recent"
                                 Tag="{StaticResource IcoClock}" GroupName="Nav" IsChecked="True" Click="Nav_Click"/>
                    <RadioButton x:Name="NavHome" Style="{StaticResource RailItem}" Content="Home" ToolTip="Home"
                                 Tag="{StaticResource IcoHome}" GroupName="Nav" Click="Nav_Click"/>
                    <RadioButton x:Name="NavVideos" Style="{StaticResource RailItem}" Content="Videos" ToolTip="Videos"
                                 Tag="{StaticResource IcoVideo}" GroupName="Nav" Click="Nav_Click"/>
                    <RadioButton x:Name="NavMusic" Style="{StaticResource RailItem}" Content="Music" ToolTip="Music"
                                 Tag="{StaticResource IcoMusic}" GroupName="Nav" Click="Nav_Click"/>
                    <RadioButton x:Name="NavPlaylists" Style="{StaticResource RailItem}" Content="Playlists" ToolTip="Playlists"
                                 Tag="{StaticResource IcoPlaylist}" GroupName="Nav" Click="Nav_Click"/>
                    <RadioButton x:Name="NavAdd" Style="{StaticResource RailItem}" Content="Add item" ToolTip="Add item"
                                 Tag="{StaticResource IcoAdd}" GroupName="NavAdd" Click="NavAdd_Click"/>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1">
                <!-- ================= Library view ================= -->
                <Grid x:Name="LibraryView">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="54"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="4,0,4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="LibBackButton" Grid.Column="0" Style="{StaticResource FigmaIconButton}" ToolTip="Back" Click="LibBack_Click">
                            <Path Style="{StaticResource Ico}" Data="{StaticResource IcoBack}"/>
                        </Button>
                        <Button x:Name="LibForwardButton" Grid.Column="1" Style="{StaticResource FigmaIconButton}" ToolTip="Forward" Click="LibForward_Click">
                            <Path Style="{StaticResource Ico}" Data="{StaticResource IcoForward}"/>
                        </Button>
                        <TextBlock x:Name="LibPathText" Grid.Column="2" Margin="12,0" FontSize="15" FontWeight="SemiBold"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="Home"/>
                        <Button x:Name="NewPlaylistButton" Grid.Column="3" Content="+  New playlist" Style="{StaticResource AccentButton}"
                                Padding="14,6" Margin="0,0,14,0" Visibility="Collapsed" Click="NewPlaylist_Click"/>
                        <Button x:Name="ClearRecentButton" Grid.Column="3" Content="Clear" Style="{StaticResource FlatButton}"
                                Padding="14,6" Margin="0,0,14,0" Visibility="Collapsed" Click="ClearRecent_Click"/>
                        <TextBlock x:Name="CountText" Grid.Column="4" Margin="0,0,12,0" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Fg3Brush}" Text="0 items"/>
                        <Button Grid.Column="5" Style="{StaticResource FigmaIconButton}" ToolTip="Sort A–Z / Z–A" Click="Sort_Click">
                            <Path Style="{StaticResource Ico}" Data="{StaticResource IcoSort}"/>
                        </Button>
                        <Button Grid.Column="6" Style="{StaticResource FigmaIconButton}" ToolTip="Grid / list view" Click="ViewToggle_Click">
                            <Path x:Name="ViewToggleIcon" Style="{StaticResource Ico}" Data="{StaticResource IcoList}"/>
                        </Button>
                        <Grid Grid.Column="7" Width="230" Margin="8,0,6,0">
                            <TextBox x:Name="SearchBox" Style="{StaticResource DarkTextBox}" Padding="36,0,10,0"
                                     TextChanged="SearchBox_TextChanged"/>
                            <Path Style="{StaticResource Ico}" Data="{StaticResource IcoSearch}"
                                  Stroke="{DynamicResource Fg3Brush}" HorizontalAlignment="Left" Margin="6,0,0,0"/>
                            <TextBlock x:Name="SearchPlaceholder" Text="Search" Margin="37,0,0,0" FontSize="13"
                                       Foreground="{DynamicResource Fg3Brush}" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>
                        <Button Grid.Column="8" Style="{StaticResource FigmaIconButton}" ToolTip="Menu" Click="MenuButton_Click">
                            <Path Style="{StaticResource Ico}" Data="{StaticResource IcoMore}"/>
                        </Button>
                    </Grid>

                    <!-- playlist header (shown when a playlist is open) -->
                    <Grid x:Name="PlHeader" Grid.Row="1" Margin="4,8,4,14" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="132" Height="132" CornerRadius="16" Background="{DynamicResource RaisedBrush}">
                            <Grid>
                                <Path Style="{StaticResource Ico}" Data="{StaticResource IcoPlaylist}" Stroke="{DynamicResource Fg3Brush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform><ScaleTransform ScaleX="2" ScaleY="2"/></Path.RenderTransform>
                                </Path>
                                <Rectangle RadiusX="16" RadiusY="16">
                                    <Rectangle.Fill><ImageBrush x:Name="PlCoverBrush" Stretch="UniformToFill"/></Rectangle.Fill>
                                </Rectangle>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="PLAYLIST" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock x:Name="PlName" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="PlInfo" FontSize="12" Margin="0,4,0,12" Foreground="{DynamicResource Fg3Brush}"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Play" Style="{StaticResource AccentButton}" Padding="22,7" Margin="0,0,8,0" Click="PlPlay_Click"/>
                                <ToggleButton x:Name="PlShuffleToggle" Style="{StaticResource FigmaIconToggle}" ToolTip="Shuffle" Click="Shuffle_Click">
                                    <Path Style="{StaticResource Ico}" Data="{StaticResource IcoShuffle}"/>
                                </ToggleButton>
                                <Button x:Name="PlLoopButton" Style="{StaticResource FigmaIconButton}" ToolTip="Repeat" Click="Loop_Click">
                                    <Grid>
                                        <Path x:Name="PlLoopIcon" Style="{StaticResource Ico}" Data="{StaticResource IcoRepeat}"/>
                                        <TextBlock x:Name="PlLoopBadge" Text="1" FontSize="9" FontWeight="Bold" Visibility="Collapsed"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource FigmaIconButton}" ToolTip="Rename" Click="PlRename_Click">
                                    <Path Style="{StaticResource Ico}" Data="{StaticResource IcoEdit}"/>
                                </Button>
                                <Button Style="{StaticResource FigmaIconButton}" ToolTip="Change cover picture" Click="PlCover_Click">
                                    <Path Style="{StaticResource Ico}" Data="{StaticResource IcoCamera}"/>
                                </Button>
                                <Button Style="{StaticResource FigmaIconButton}" ToolTip="Delete playlist" Click="PlDelete_Click">
                                    <Path Style="{StaticResource Ico}" Data="{StaticResource IcoTrash}"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Border Height="1" VerticalAlignment="Top" Background="{DynamicResource RaisedBrush}"/>
                        <ListBox x:Name="LibraryList" Style="{StaticResource PlaylistList}"
                                 ItemContainerStyle="{StaticResource TileRowItem}" Margin="0,10,0,0"
                                 HorizontalAlignment="Left" MaxWidth="1100"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                                 />
                        <StackPanel x:Name="LibEmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="True">
                            <TextBlock x:Name="LibEmptyHint" TextWrapping="Wrap" TextAlignment="Center" FontSize="14" MaxWidth="420"
                                       Foreground="{DynamicResource Fg3Brush}"
                                       Text="Nothing here yet."/>
                            <Button x:Name="LibEmptyButton" Content="Open a folder" Style="{StaticResource FlatButton}" Margin="0,16,0,0"
                                    HorizontalAlignment="Center" Click="LibEmpty_Click"/>
                        </StackPanel>

                        <!-- mini player (video preview sits just above it) -->
                        <Border x:Name="MiniPlayer" Visibility="Collapsed" Width="320" HorizontalAlignment="Right"
                                VerticalAlignment="Bottom" Margin="0,0,6,6" Padding="12"
                                Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource SlateBrush}"
                                BorderThickness="1" CornerRadius="14">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Style="{StaticResource PlayPillButton}" Width="40" Height="30"
                                            Click="PlayPause_Click">
                                        <Path x:Name="MiniPlayIcon" Style="{StaticResource IcoFilled}" Data="{StaticResource IcoPlay}"/>
                                    </Button>
                                    <TextBlock x:Name="MiniTitle" Grid.Column="1" Margin="12,0" FontSize="13" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="2" Style="{StaticResource FigmaIconButton}" ToolTip="Open player" Click="MiniExpand_Click">
                                        <Path Style="{StaticResource Ico}" Data="{StaticResource IcoFullscreen}"/>
                                    </Button>
                                    <Button Grid.Column="3" Style="{StaticResource FigmaIconButton}" ToolTip="Close" Click="MiniClose_Click">
                                        <Path Style="{StaticResource Ico}" Data="{StaticResource IcoClose}"/>
                                    </Button>
                                </Grid>
                                <Border Height="6" CornerRadius="3" Margin="0,10,0,0" Background="{DynamicResource TrackBrush}">
                                    <Border x:Name="MiniProgress" Width="0" HorizontalAlignment="Left" CornerRadius="3"
                                            Background="{DynamicResource AccentBrush}"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ================= Player view (full, or a small video preview while browsing) ================= -->
                <Grid x:Name="PlayerView">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- queue / playlists panel -->
                    <Border x:Name="SidebarPanel" Grid.Column="0" Width="330" Margin="0,0,8,0"
                            Background="{DynamicResource PanelBrush}" CornerRadius="12" Visibility="Collapsed">
                        <Grid Margin="14,12,14,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Height="34">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="SideTabQueue" Style="{StaticResource SegmentButton}" Content="Queue (Q)"
                                                 GroupName="SideTab" IsChecked="True" Checked="SideTab_Checked"/>
                                    <RadioButton x:Name="SideTabPlaylists" Style="{StaticResource SegmentButton}" Content="Playlists (P)"
                                                 GroupName="SideTab" Checked="SideTab_Checked"/>
                                </StackPanel>
                                <Button x:Name="SideAddButton" HorizontalAlignment="Right" Style="{StaticResource FigmaIconButton}"
                                        ToolTip="Add to queue" Click="SideAdd_Click">
                                    <Path Style="{StaticResource Ico}" Data="{StaticResource IcoAdd}"/>
                                </Button>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <TextBox x:Name="SideSearch" Style="{StaticResource DarkTextBox}" Padding="34,0,10,0"
                                             TextChanged="SideSearch_TextChanged"/>
                                    <Path Style="{StaticResource Ico}" Data="{StaticResource IcoSearch}"
                                          Stroke="{DynamicResource Fg3Brush}" HorizontalAlignment="Left" Margin="5,0,0,0"/>
                                    <TextBlock x:Name="SideSearchHint" Text="Search" Margin="35,0,0,0" FontSize="13"
                                               Foreground="{DynamicResource Fg3Brush}" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                </Grid>
                                <Button Grid.Column="1" Style="{StaticResource FigmaIconButton}" Margin="6,0,0,0" ToolTip="Sort A–Z / Z–A"
                                        Click="SideSort_Click">
                                    <Path Style="{StaticResource Ico}" Data="{StaticResource IcoSort}"/>
                                </Button>
                            </Grid>

                            <!-- open playlist header -->
                            <Border x:Name="SidePlHeader" Grid.Row="2" Margin="0,10,0,0" Padding="10" CornerRadius="10"
                                    Background="{DynamicResource RaisedBrush}" Visibility="Collapsed">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Style="{StaticResource FigmaIconButton}" ToolTip="Back to playlists" Click="SidePlBack_Click">
                                            <Path Style="{StaticResource Ico}" Data="{StaticResource IcoBack}"/>
                                        </Button>
                                        <StackPanel Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="SidePlName" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="SidePlInfo" FontSize="11" Foreground="{DynamicResource Fg3Brush}"/>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="Play" Style="{StaticResource AccentButton}" Padding="16,5" Margin="0,0,6,0" Tag="side" Click="PlPlay_Click"/>
                                        <ToggleButton x:Name="SideShuffleToggle" Style="{StaticResource FigmaIconToggle}" ToolTip="Shuffle" Click="Shuffle_Click">
                                            <Path Style="{StaticResource Ico}" Data="{StaticResource IcoShuffle}"/>
                                        </ToggleButton>
                                        <Button x:Name="SideLoopButton" Style="{StaticResource FigmaIconButton}" ToolTip="Repeat" Click="Loop_Click">
                                            <Grid>
                                                <Path x:Name="SideLoopIcon" Style="{StaticResource Ico}" Data="{StaticResource IcoRepeat}"/>
                                                <TextBlock x:Name="SideLoopBadge" Text="1" FontSize="9" FontWeight="Bold" Visibility="Collapsed"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                                            </Grid>
                                        </Button>
                                        <Button Style="{StaticResource FigmaIconButton}" ToolTip="Rename" Tag="side" Click="PlRename_Click">
                                            <Path Style="{StaticResource Ico}" Data="{StaticResource IcoEdit}"/>
                                        </Button>
                                        <Button Style="{StaticResource FigmaIconButton}" ToolTip="Change cover picture" Tag="side" Click="PlCover_Click">
                                            <Path Style="{StaticResource Ico}" Data="{StaticResource IcoCamera}"/>
                                        </Button>
                                        <Button Style="{StaticResource FigmaIconButton}" ToolTip="Delete playlist" Tag="side" Click="PlDelete_Click">
                                            <Path Style="{StaticResource Ico}" Data="{StaticResource IcoTrash}"/>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Grid Grid.Row="3">
                                <ListBox x:Name="SideList" Style="{StaticResource PlaylistList}"
                                         ItemContainerStyle="{StaticResource PlaylistItem}" ItemTemplate="{StaticResource SideTpl}"
                                         MouseDoubleClick="SideList_MouseDoubleClick"/>
                                <StackPanel x:Name="SideEmptyPanel" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,34,0,0">
                                    <TextBlock x:Name="SideEmptyHint" TextWrapping="Wrap" TextAlignment="Center" FontSize="13" MaxWidth="260"
                                               Foreground="{DynamicResource Fg3Brush}" Text="Your queue is empty."/>
                                    <Button x:Name="SideEmptyButton" Content="Add to queue" Style="{StaticResource FlatButton}" Margin="0,14,0,0"
                                            HorizontalAlignment="Center" Click="SideAdd_Click"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Video area. VideoView is a native surface ("airspace"), so everything that must sit on top of the
                         picture (empty state, music view, volume popup, floating fullscreen bar) is its Content. -->
                    <Grid x:Name="VideoHost" Grid.Column="1" Background="Black">
                        <vlc:VideoView x:Name="VideoView">
                            <Grid x:Name="VideoSurface" Background="#01000000"
                                  MouseLeftButtonDown="VideoSurface_MouseLeftButtonDown"
                                  MouseRightButtonUp="VideoSurface_MouseRightButtonUp"
                                  MouseMove="VideoSurface_MouseMove">
                                <StackPanel x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            IsHitTestVisible="False">
                                    <Image Source="Assets/app.ico" Width="84" Height="84"
                                           RenderOptions.BitmapScalingMode="HighQuality" Opacity="0.9"/>
                                    <TextBlock Text="EchoDeck" FontSize="26" FontWeight="SemiBold" Margin="0,14,0,0"
                                               Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Pick something from the library to start playing"
                                               FontSize="14" Margin="0,6,0,0" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource Fg3Brush}"/>
                                </StackPanel>

                                <Grid x:Name="MusicPanel" Visibility="Collapsed" Background="{DynamicResource PanelBrush}">
                                    <Ellipse Width="760" Height="760" Opacity="0.24" HorizontalAlignment="Center"
                                             VerticalAlignment="Center" IsHitTestVisible="False">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush>
                                                <GradientStop x:Name="GlowStop" Color="{DynamicResource AccentColor}" Offset="0"/>
                                                <GradientStop Color="#00000000" Offset="1"/>
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <Grid Width="360" Height="360" HorizontalAlignment="Center">
                                            <Ellipse x:Name="PulseRing" Width="330" Height="330" Stroke="{DynamicResource AccentBrush}"
                                                     StrokeThickness="2.5" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                                <Ellipse.RenderTransform>
                                                    <ScaleTransform x:Name="PulseScale" ScaleX="1" ScaleY="1"/>
                                                </Ellipse.RenderTransform>
                                            </Ellipse>
                                            <Ellipse x:Name="CoverCircle" Width="310" Height="310" Fill="{StaticResource CoverFallback}"/>
                                            <Path x:Name="MusicGlyph" Data="{StaticResource IcoMusic}" Stretch="Uniform" Width="90" Height="90"
                                                  Stroke="White" StrokeThickness="1.6" StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                        </Grid>
                                        <TextBlock x:Name="MusicTitle" FontSize="20" FontWeight="SemiBold" Margin="0,24,0,0"
                                                   MaxWidth="560" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="MusicSubtitle" FontSize="14" Margin="0,6,0,0" MaxWidth="560"
                                                   TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <!-- rounded video corners (the picture itself can't be clipped) -->
                                <local:CornerMask x:Name="VideoCorners" Radius="14"/>

                                <!-- on-screen indicator (volume, seek, speed ...) -->
                                <Border x:Name="OsdBox" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Margin="0,22,22,0" Padding="16,10" CornerRadius="12" Background="#D8101010"
                                        IsHitTestVisible="False">
                                    <StackPanel>
                                        <TextBlock x:Name="OsdText" Foreground="White" FontSize="14" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"/>
                                        <Border x:Name="OsdBarHost" Width="140" Height="5" CornerRadius="3" Margin="0,8,0,0"
                                                Background="#44FFFFFF" Visibility="Collapsed">
                                            <Border x:Name="OsdBarFill" HorizontalAlignment="Left" CornerRadius="3" Width="0"
                                                    Background="{DynamicResource AccentBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- the control bar floats here in fullscreen -->
                                <Border x:Name="FloatingBar" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                        Margin="40,0,40,30" MaxWidth="1280" CornerRadius="20"
                                        Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource SlateBrush}"
                                        BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.55" Color="Black"/>
                                    </Border.Effect>
                                </Border>
                            </Grid>
                        </vlc:VideoView>
                    </Grid>

                    <!-- quick settings panel (Figma: Video / Audio / Subtitles side panel) -->
                    <Border x:Name="QuickPanel" Grid.Column="2" Width="296" Margin="8,0,0,0" Visibility="Collapsed"
                            Background="{DynamicResource PanelBrush}" CornerRadius="12">
                        <Grid Margin="14,10,14,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Height="32">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="QTabVideo" Style="{StaticResource SegmentButton}" Content="Video" GroupName="QTab" IsChecked="True" Checked="QTab_Checked"/>
                                    <RadioButton x:Name="QTabAudio" Style="{StaticResource SegmentButton}" Content="Audio" GroupName="QTab" Checked="QTab_Checked"/>
                                    <RadioButton x:Name="QTabSubs" Style="{StaticResource SegmentButton}" Content="Subs" GroupName="QTab" Checked="QTab_Checked"/>
                                </StackPanel>
                                <Button HorizontalAlignment="Right" Style="{StaticResource FigmaIconButton}" Width="28" Height="28" Click="QuickClose_Click">
                                    <Path Style="{StaticResource Ico}" Data="{StaticResource IcoClose}"/>
                                </Button>
                            </Grid>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                                <Grid>
                                    <StackPanel x:Name="QPageVideo">
                                        <Grid Margin="0,0,0,8">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <TextBlock Text="Hue" Style="{StaticResource HintText}" Margin="0,0,0,3"/>
                                            <TextBlock x:Name="QHueValue" Style="{StaticResource HintText}" HorizontalAlignment="Right"/>
                                            <Slider x:Name="QHue" Grid.Row="1" Style="{StaticResource SmallSlider}" Minimum="-180" Maximum="180" IsMoveToPointEnabled="True" ValueChanged="QuickSlider_Changed"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <TextBlock Text="Brightness" Style="{StaticResource HintText}" Margin="0,0,0,3"/>
                                            <TextBlock x:Name="QBrightnessValue" Style="{StaticResource HintText}" HorizontalAlignment="Right"/>
                                            <Slider x:Name="QBrightness" Grid.Row="1" Style="{StaticResource SmallSlider}" Minimum="0" Maximum="2" IsMoveToPointEnabled="True" ValueChanged="QuickSlider_Changed"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <TextBlock Text="Contrast" Style="{StaticResource HintText}" Margin="0,0,0,3"/>
                                            <TextBlock x:Name="QContrastValue" Style="{StaticResource HintText}" HorizontalAlignment="Right"/>
                                            <Slider x:Name="QContrast" Grid.Row="1" Style="{StaticResource SmallSlider}" Minimum="0" Maximum="2" IsMoveToPointEnabled="True" ValueChanged="QuickSlider_Changed"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <TextBlock Text="Saturation" Style="{StaticResource HintText}" Margin="0,0,0,3"/>
                                            <TextBlock x:Name="QSaturationValue" Style="{StaticResource HintText}" HorizontalAlignment="Right"/>
                                            <Slider x:Name="QSaturation" Grid.Row="1" Style="{StaticResource SmallSlider}" Minimum="0" Maximum="3" IsMoveToPointEnabled="True" ValueChanged="QuickSlider_Changed"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <TextBlock Text="Gamma" Style="{StaticResource HintText}" Margin="0,0,0,3"/>
                                            <TextBlock x:Name="QGammaValue" Style="{StaticResource HintText}" HorizontalAlignment="Right"/>
                                            <Slider x:Name="QGamma" Grid.Row="1" Style="{StaticResource SmallSlider}" Minimum="0.1" Maximum="4" IsMoveToPointEnabled="True" ValueChanged="QuickSlider_Changed"/>
                                        </Grid>
                                        <Button Content="Reset picture" Style="{StaticResource FlatButton}" Padding="12,5" HorizontalAlignment="Left"
                                                Margin="0,0,0,12" Click="QuickReset_Click"/>
                                        <TextBlock Text="Aspect ratio" Style="{StaticResource HintText}" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="QAspectCombo" Style="{StaticResource EchoCombo}" MinWidth="0" Height="32" Margin="0,0,0,10" SelectionChanged="QuickCombo_Changed"/>
                                        <TextBlock Text="Playback speed" Style="{StaticResource HintText}" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="QSpeedCombo" Style="{StaticResource EchoCombo}" MinWidth="0" Height="32" SelectionChanged="QuickCombo_Changed"/>
                                    </StackPanel>

                                    <StackPanel x:Name="QPageAudio" Visibility="Collapsed">
                                        <TextBlock Text="Audio track" Style="{StaticResource HintText}" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="QAudioCombo" Style="{StaticResource EchoCombo}" MinWidth="0" Height="32" Margin="0,0,0,10" SelectionChanged="QuickCombo_Changed"/>
                                        <TextBlock Text="Equalizer" Style="{StaticResource HintText}" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="QEqCombo" Style="{StaticResource EchoCombo}" MinWidth="0" Height="32" SelectionChanged="QuickCombo_Changed"/>
                                        <TextBlock x:Name="QAudioHint" Style="{StaticResource HintText}" Margin="0,10,0,0"/>
                                    </StackPanel>

                                    <StackPanel x:Name="QPageSubs" Visibility="Collapsed">
                                        <TextBlock Text="Subtitle track" Style="{StaticResource HintText}" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="QSubCombo" Style="{StaticResource EchoCombo}" MinWidth="0" Height="32" Margin="0,0,0,10" SelectionChanged="QuickCombo_Changed"/>
                                        <Button x:Name="QAddSubButton" Content="Add subtitle file…" Style="{StaticResource FlatButton}" Padding="12,5"
                                                HorizontalAlignment="Left" Click="QuickAddSub_Click"/>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>

                            <Button Grid.Row="2" Content="All settings…" Style="{StaticResource FlatButton}" Padding="12,6" Margin="0,8,0,0"
                                    Click="AllSettings_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ===================== Control bar ===================== -->
        <Border x:Name="ControlBar" Grid.Row="2" Height="58" Background="{DynamicResource BgBrush}" Padding="18,0" Visibility="Collapsed">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Bundle}">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="PrevButton" Style="{StaticResource BundleButton}" ToolTip="Previous (Shift+,)" Click="Previous_Click">
                            <Path Style="{StaticResource IcoFilled}" Data="{StaticResource IcoPrevious}"/>
                        </Button>
                        <Button x:Name="BackButton" Style="{StaticResource BundleButton}" ToolTip="Back (Left arrow)" Click="SkipBack_Click">
                            <Path Style="{StaticResource IcoFilled}" Data="{StaticResource IcoSeekBack}"/>
                        </Button>
                        <Button x:Name="PlayPauseButton" Style="{StaticResource PlayPillButton}" Margin="4,0"
                                ToolTip="Play / Pause (Space)" Click="PlayPause_Click">
                            <Path x:Name="PlayPauseIcon" Style="{StaticResource IcoFilled}" Data="{StaticResource IcoPlay}"/>
                        </Button>
                        <Button x:Name="FwdButton" Style="{StaticResource BundleButton}" ToolTip="Forward (Right arrow)" Click="SkipFwd_Click">
                            <Path Style="{StaticResource IcoFilled}" Data="{StaticResource IcoSeekFwd}"/>
                        </Button>
                        <Button x:Name="NextButton" Style="{StaticResource BundleButton}" ToolTip="Next (Shift+.)" Click="Next_Click">
                            <Path Style="{StaticResource IcoFilled}" Data="{StaticResource IcoNext}"/>
                        </Button>
                    </StackPanel>
                </Border>

                <Grid Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="72"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TimeText" Grid.Column="0" Text="00:00:00" FontSize="14"
                               Foreground="{DynamicResource MutedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <local:WaveformBar x:Name="SeekBar" Grid.Column="1" Flat="True" Height="28" Margin="6,0" IsEnabled="False"/>
                    <local:WaveformBar x:Name="WaveBar" Grid.Column="1" Height="38" Margin="6,0" Visibility="Collapsed"/>

                    <TextBlock x:Name="DurationText" Grid.Column="2" Text="00:00:00" FontSize="14"
                               Foreground="{DynamicResource MutedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <ToggleButton x:Name="ShuffleToggle" Style="{StaticResource FigmaIconToggle}" ToolTip="Shuffle"
                                  Click="Shuffle_Click">
                        <Path Style="{StaticResource Ico}" Data="{StaticResource IcoShuffle}"/>
                    </ToggleButton>
                    <Button x:Name="LoopButton" Style="{StaticResource FigmaIconButton}" ToolTip="Repeat: off" Click="Loop_Click">
                        <Grid>
                            <Path x:Name="LoopIcon" Style="{StaticResource Ico}" Data="{StaticResource IcoRepeat}"/>
                            <TextBlock x:Name="LoopBadge" Text="1" FontSize="9" FontWeight="Bold" Visibility="Collapsed"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- volume: click the speaker for the slider -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Button x:Name="VolumeButton" Style="{StaticResource FigmaIconButton}" ToolTip="Volume (M mutes)" Click="Volume_Click">
                        <Path x:Name="VolumeIcon" Style="{StaticResource Ico}" Data="{StaticResource IcoVolume}"/>
                    </Button>
                    <TextBlock x:Name="VolumeText" Width="38" FontSize="12" Foreground="{DynamicResource Fg3Brush}"
                               VerticalAlignment="Center" TextAlignment="Left" Margin="2,0,0,0"/>
                    <Popup x:Name="VolumePopup" PlacementTarget="{Binding ElementName=VolumeButton}" Placement="Top"
                           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Closed="VolumePopup_Closed">
                        <Border Margin="14" Padding="14,12" CornerRadius="14" Background="{DynamicResource PanelBrush}"
                                BorderBrush="{DynamicResource SlateBrush}" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.5" Color="Black"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="MuteButton" Style="{StaticResource FigmaIconButton}" ToolTip="Mute" Click="Mute_Click">
                                    <Path x:Name="PopupVolumeIcon" Style="{StaticResource Ico}" Data="{StaticResource IcoVolume}"/>
                                </Button>
                                <Slider x:Name="VolumeSlider" Style="{StaticResource WedgeSlider}" Margin="8,0,0,0"
                                        Minimum="0" Maximum="100" Value="80" IsMoveToPointEnabled="True"
                                        ValueChanged="VolumeSlider_ValueChanged"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>

                <Border Grid.Column="4" Style="{StaticResource Bundle}" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="AudioButton" Style="{StaticResource BundleButton}" ToolTip="Audio (B cycles tracks)"
                                Click="Audio_Click">
                            <Path Style="{StaticResource Ico}" Data="{StaticResource IcoAudio}"/>
                        </Button>
                        <Button x:Name="SubtitleButton" Style="{StaticResource BundleButton}" ToolTip="Subtitles (V cycles tracks)"
                                Click="Subtitle_Click">
                            <Path Style="{StaticResource Ico}" Data="{StaticResource IcoSubtitles}"/>
                        </Button>
                        <Button x:Name="SettingsButton" Style="{StaticResource BundleButton}" ToolTip="Video settings"
                                Click="Settings_Click">
                            <Path Style="{StaticResource Ico}" Data="{StaticResource IcoSettings}"/>
                        </Button>
                    </StackPanel>
                </Border>

                <ToggleButton x:Name="ControlsPlaylistToggle" Grid.Column="5" Style="{StaticResource FigmaIconToggle}"
                              ToolTip="Queue (Q) / playlists (P)" VerticalAlignment="Center" Click="SidebarToggle_Click">
                    <Path Style="{StaticResource Ico}" Data="{StaticResource IcoPlaylist}"/>
                </ToggleButton>
            </Grid>
        </Border>
    </Grid>
</Window>
