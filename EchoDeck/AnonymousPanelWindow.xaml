<Window x:Class="EchoDeck.AnonymousPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Anonymous"
        FontFamily="{StaticResource UiFont}"
        Foreground="{DynamicResource TextBrush}"
        Width="404" Height="560"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize" WindowStartupLocation="Manual"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- row delete button: only visible while the row is hovered -->
        <Style x:Key="RowDeleteButton" TargetType="Button" BasedOn="{StaticResource FigmaIconButton}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- The window is fixed-size and fully transparent; only this shell is visible. It animates between a small pill and the panel. -->
    <Border x:Name="Shell"
            HorizontalAlignment="Left" VerticalAlignment="Top"
            Width="48" Height="28" CornerRadius="18" Opacity="0.45"
            Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
            ClipToBounds="True" AllowDrop="True" Drop="Shell_Drop"
            MouseEnter="Shell_MouseEnter" MouseLeave="Shell_MouseLeave">
        <Grid>
            <TextBlock x:Name="PillIcon" Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                       Foreground="{DynamicResource AccentBrush}"
                       Width="46" Height="26" TextAlignment="Center" Padding="0,6,0,0"
                       HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"/>

            <Grid x:Name="Deck" Width="400" Height="556"
                  HorizontalAlignment="Left" VerticalAlignment="Top"
                  Opacity="0" IsHitTestVisible="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- header -->
                <Grid Grid.Row="0" Margin="18,16,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="13" Background="{DynamicResource AccentSoftBrush}">
                        <Path Style="{StaticResource Ico}" Data="{StaticResource IcoLock}" Stroke="{DynamicResource AccentBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                        <TextBlock Text="Anonymous Mode" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock x:Name="CountText" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="SettingsButton" Style="{StaticResource FigmaIconButton}" ToolTip="Anonymous Mode settings"
                                Click="Settings_Click">
                            <Path Style="{StaticResource Ico}" Data="{StaticResource IcoSettings}"/>
                        </Button>
                        <Button Style="{StaticResource FigmaIconButton}" ToolTip="Leave Anonymous Mode (Esc)" Click="Leave_Click">
                            <Path Style="{StaticResource Ico}" Data="{StaticResource IcoClose}"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- search + sort -->
                <Grid Grid.Row="1" Margin="18,6,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox x:Name="SearchBox" Style="{StaticResource DarkTextBox}" Height="36" Padding="34,0,10,0"
                                 TextChanged="SearchBox_TextChanged"/>
                        <Path Style="{StaticResource Ico}" Data="{StaticResource IcoSearch}" Stroke="{DynamicResource Fg3Brush}"
                              HorizontalAlignment="Left" Margin="4,0,0,0"/>
                        <TextBlock x:Name="SearchHint" Text="Search your vault" Margin="35,0,0,0" FontSize="13"
                                   Foreground="{DynamicResource Fg3Brush}" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                    <Button Grid.Column="1" Style="{StaticResource FigmaIconButton}" Margin="6,0,0,0" ToolTip="Sort A–Z / Z–A" Click="Sort_Click">
                        <Path Style="{StaticResource Ico}" Data="{StaticResource IcoSort}"/>
                    </Button>
                </Grid>

                <!-- filter chips -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="16,10,0,6">
                    <RadioButton x:Name="ChipAll" Style="{StaticResource SegmentButton}" Content="All" GroupName="VaultFilter" IsChecked="True" Checked="Filter_Checked"/>
                    <RadioButton x:Name="ChipVideo" Style="{StaticResource SegmentButton}" Content="Videos" GroupName="VaultFilter" Checked="Filter_Checked"/>
                    <RadioButton x:Name="ChipAudio" Style="{StaticResource SegmentButton}" Content="Music" GroupName="VaultFilter" Checked="Filter_Checked"/>
                </StackPanel>

                <!-- items -->
                <Grid Grid.Row="3" Margin="12,0,10,0">
                    <ListBox x:Name="VaultList" Style="{StaticResource PlaylistList}"
                             ItemContainerStyle="{StaticResource PlaylistItem}"
                             MouseDoubleClick="VaultList_MouseDoubleClick"
                             SelectionChanged="VaultList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="Transparent">
                                    <Grid Height="54">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="40" Height="40" CornerRadius="11" Background="{DynamicResource RaisedBrush}"
                                                HorizontalAlignment="Left" Margin="4,0,0,0">
                                            <Path Style="{StaticResource Ico}" Data="{Binding Icon}" Stroke="{DynamicResource AccentBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextBrush}"/>
                                            <TextBlock Text="{Binding Subtitle, Mode=OneWay}" FontSize="11" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource MutedBrush}"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource RowDeleteButton}" ToolTip="Delete permanently"
                                                Click="RowDelete_Click">
                                            <Path Style="{StaticResource Ico}" Data="{StaticResource IcoTrash}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                Visibility="Collapsed">
                        <Path Style="{StaticResource Ico}" Data="{StaticResource IcoImport}" Stroke="{DynamicResource Fg3Brush}"
                              HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform><ScaleTransform ScaleX="1.8" ScaleY="1.8"/></Path.RenderTransform>
                        </Path>
                        <TextBlock x:Name="EmptyText" Margin="0,18,0,0" TextAlignment="Center" FontSize="13" MaxWidth="260"
                                   TextWrapping="Wrap" Foreground="{DynamicResource Fg3Brush}"
                                   Text="Nothing here yet. Drop files or a folder onto this panel, or use the buttons below."/>
                    </StackPanel>
                </Grid>

                <!-- progress + status -->
                <StackPanel Grid.Row="4" Margin="18,8,18,0">
                    <Border x:Name="ImportTrack" Height="4" CornerRadius="2" Background="{DynamicResource TrackBrush}" Visibility="Collapsed">
                        <Border x:Name="ImportFill" Width="0" HorizontalAlignment="Left" CornerRadius="2" Background="{DynamicResource AccentBrush}"/>
                    </Border>
                    <TextBlock x:Name="StatusText" FontSize="11" Margin="0,6,0,0" MinHeight="14"
                               Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- actions -->
                <Grid Grid.Row="5" Margin="14,8,14,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ImportFilesButton" Grid.Column="0" Content="+ Files" Padding="4,9"
                            Style="{StaticResource FlatButton}" Click="ImportFiles_Click" ToolTip="Encrypt files into Anonymous Mode"/>
                    <Button x:Name="ImportFolderButton" Grid.Column="2" Content="+ Folder" Padding="4,9"
                            Style="{StaticResource FlatButton}" Click="ImportFolder_Click" ToolTip="Encrypt a whole folder into Anonymous Mode"/>
                    <Button x:Name="PlayButton" Grid.Column="4" Content="Play" Padding="4,9"
                            Style="{StaticResource AccentButton}" Click="Play_Click"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
