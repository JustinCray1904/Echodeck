<Window x:Class="EchoDeck.AnonymousPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Anonymous"
        FontFamily="{StaticResource UiFont}"
        Foreground="{DynamicResource TextBrush}"
        Width="324" Height="396"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize" WindowStartupLocation="Manual"
        PreviewKeyDown="Window_PreviewKeyDown">

    <!-- The window is fixed-size and fully transparent; only this shell is visible/hit-testable.
         It animates between a small pill and the full panel. -->
    <Border x:Name="Shell"
            HorizontalAlignment="Left" VerticalAlignment="Top"
            Width="48" Height="28" CornerRadius="14" Opacity="0.45"
            Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
            ClipToBounds="True"
            MouseEnter="Shell_MouseEnter" MouseLeave="Shell_MouseLeave">
        <Grid>
            <!-- Idle pill: tiny mask glyph -->
            <TextBlock x:Name="PillIcon" Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                       Foreground="{DynamicResource AccentBrush}"
                       Width="46" Height="26" TextAlignment="Center" Padding="0,6,0,0"
                       HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"/>

            <!-- Hover panel -->
            <Grid x:Name="Deck" Width="320" Height="392"
                  HorizontalAlignment="Left" VerticalAlignment="Top"
                  Opacity="0" IsHitTestVisible="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="16,14,12,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="ANONYMOUS MODE" Margin="8,0,0,0" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="CountText" VerticalAlignment="Center"
                                   FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                        <Button x:Name="SettingsButton" Style="{StaticResource IconButton}"
                                Content="&#xE713;" FontSize="13" Padding="6" Margin="6,-6,-4,-6"
                                ToolTip="Anonymous Mode settings" Click="Settings_Click"/>
                    </StackPanel>
                </Grid>

                <ListBox x:Name="VaultList" Grid.Row="1" Margin="12,0"
                         Style="{StaticResource DarkList}"
                         ItemContainerStyle="{StaticResource DarkItem}"
                         MouseDoubleClick="VaultList_MouseDoubleClick"
                         SelectionChanged="VaultList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="12"
                                           Foreground="{DynamicResource TextBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock FontSize="10" Foreground="{DynamicResource MutedBrush}">
                                    <Run Text="{Binding Kind, Mode=OneWay}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding SizeText, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="StatusText" Grid.Row="2" Margin="16,8,16,0" FontSize="11"
                           Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"
                           MinHeight="14"/>

                <Grid Grid.Row="3" Margin="12,8,12,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ImportFilesButton" Grid.Column="0" Content="+ Files" FontSize="12" Padding="4,7"
                            Style="{StaticResource FlatButton}" Click="ImportFiles_Click"
                            ToolTip="Encrypt files into Anonymous Mode"/>
                    <Button x:Name="ImportFolderButton" Grid.Column="2" Content="+ Folder" FontSize="12" Padding="4,7"
                            Style="{StaticResource FlatButton}" Click="ImportFolder_Click"
                            ToolTip="Encrypt a whole folder into Anonymous Mode"/>
                    <Button x:Name="PlayButton" Grid.Column="4" Content="Play" FontSize="12" Padding="4,7"
                            Style="{StaticResource AccentButton}" Click="Play_Click"/>
                    <Button x:Name="DeleteButton" Grid.Column="6" Content="Delete" FontSize="12" Padding="4,7"
                            Style="{StaticResource DangerButton}" Click="Delete_Click"
                            ToolTip="Permanently delete the selected item"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
