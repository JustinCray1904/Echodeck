<Window x:Class="EchoDeck.PasscodePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource EchoWindow}"
        Title="Anonymous Mode"
        Width="400" Height="290"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <StackPanel Margin="28,6,28,24">
        <TextBlock Text="Enter your passcode" Style="{StaticResource PageTitle}"/>
        <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,16"
                   Text="You will switch to Anonymous Mode, a private space for encrypted media."/>
        <PasswordBox x:Name="PinBox" Style="{StaticResource DarkPassword}" MaxLength="8"
                     PreviewTextInput="Digits_PreviewTextInput"/>
        <TextBlock x:Name="ErrorText" Margin="0,10,0,0" MinHeight="16" FontSize="12"
                   Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"/>
        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Cancel" Style="{StaticResource FlatButton}" IsCancel="True"
                    Click="Cancel_Click"/>
            <Button Grid.Column="2" Content="Enter" Style="{StaticResource AccentButton}" IsDefault="True"
                    Click="Enter_Click"/>
        </Grid>
    </StackPanel>
</Window>
