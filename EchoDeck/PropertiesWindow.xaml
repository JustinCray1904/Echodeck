<Window x:Class="EchoDeck.PropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource EchoWindow}"
        Title="Properties"
        Width="520" Height="410"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <Grid Margin="24,0,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,14">
                    <TextBlock Text="Title" Style="{StaticResource HintText}"/>
                    <TextBlock x:Name="TitleValue" FontSize="14" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,14">
                    <TextBlock Text="Length" Style="{StaticResource HintText}"/>
                    <TextBlock x:Name="LengthValue" FontSize="14" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,14">
                    <TextBlock Text="Size" Style="{StaticResource HintText}"/>
                    <TextBlock x:Name="SizeValue" FontSize="14" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,12,14">
                    <TextBlock Text="Item type" Style="{StaticResource HintText}"/>
                    <TextBlock x:Name="TypeValue" FontSize="14" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,14">
                    <TextBlock Text="Modified" Style="{StaticResource HintText}"/>
                    <TextBlock x:Name="ModifiedValue" FontSize="14" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.ColumnSpan="2">
                    <TextBlock Text="File location" Style="{StaticResource HintText}"/>
                    <TextBlock x:Name="LocationValue" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,8"/>
                    <Button Content="Open file location" Background="Transparent" BorderThickness="0" Padding="0"
                            Foreground="{DynamicResource AccentBrush}" Style="{StaticResource FlatButton}" HorizontalAlignment="Left"
                            Click="OpenLocation_Click"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Button Grid.Row="1" Content="Close" Style="{StaticResource FlatButton}" Padding="20,9" Margin="0,10,0,0"
                IsCancel="True" IsDefault="True" Click="Close_Click"/>
    </Grid>
</Window>
